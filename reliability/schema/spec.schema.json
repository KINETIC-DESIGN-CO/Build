{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Reliability and Recovery Source Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_result_states", "cross_links", "discrepancy_states", "effect_states", "event_types", "evidence_roles", "evidence_source_classes", "obligation_classes", "obligation_states", "parent_binding", "recovery_dispositions", "runtime_control_authority", "schema_version", "source_artifacts", "source_contract_authority", "subsystem_id", "verification_dimensions", "verification_states"],
  "properties": {
    "schema_version":{"type":"integer","const":1},
    "subsystem_id":{"type":"string","const":"life-reliability-recovery-v1"},
    "runtime_control_authority":{"type":"string","const":"NONE"},
    "source_contract_authority":{"type":"string","const":"VERSIONED_GITHUB_SOURCE_ONLY"},
    "event_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["OCCURRENCE_OPENED","EVIDENCE_ATTACHED","PROPOSITION_RECORDED","DISCREPANCY_OPENED","DISCREPANCY_RESOLVED","DIAGNOSIS_REVISION_RECORDED","OBLIGATION_CREATED","OPERATION_PREPARED","ATTEMPT_DISPATCHED","ATTEMPT_RESULT_RECORDED","EFFECT_OBSERVED","POSTCONDITION_OBSERVED","RECOVERY_EVALUATED","RECOVERY_DISPATCHED","RECOVERY_VERIFIED","RECURRENCE_TEST_LINKED","PARENT_RESTORATION_ELIGIBLE","PARENT_RESTORED","OCCURRENCE_RESOLVED","OCCURRENCE_REOPENED"]}},
    "attempt_result_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["PENDING","SUCCESS","FAILURE","NO_RESULT","TIMEOUT","UNKNOWN"]}},
    "effect_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["NOT_EVALUATED","NO_EFFECT_VERIFIED","EFFECT_VERIFIED","PARTIAL_EFFECT_VERIFIED","EFFECT_UNKNOWN"]}},
    "verification_dimensions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["OUTPUT_CORRECTNESS","MECHANISM_EXECUTION","SOURCE_ROUTE","EFFECT_STATE","POSTCONDITION_STATE","PROTECTED_INVARIANT_PRESERVATION","RECURRENCE_PREVENTION","SPECIFICATION_SURVIVAL","LIVE_ENFORCEMENT","PARENT_RESTORATION"]}},
    "verification_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["PASS","FAIL","UNKNOWN","NOT_RUN"]}},
    "obligation_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["OCCURRENCE_REPAIR","RECURRENCE_PREVENTION","EVIDENCE_RECOVERY","EFFECT_RECONCILIATION","VERIFIER_REPAIR","SPECIFICATION_REPAIR","LIVE_ENFORCEMENT_REPAIR","PARENT_RESTORATION","LESSON_PROMOTION"]}},
    "obligation_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["OPEN","BLOCKED_RESOURCE","BLOCKED_AUTHORIZATION","BLOCKED_COST","BLOCKED_PLATFORM","EXECUTING","VERIFYING","SATISFIED","REJECTED_NOT_APPLICABLE"]}},
    "recovery_dispositions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["ACCEPT_EFFECT","VERIFY_EFFECT","RETRY","COMPENSATE","QUARANTINE","ESCALATE","ABORT","RESUME_PARENT"]}},
    "evidence_source_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["IMMUTABLE_REPOSITORY","LIVE_GITHUB","LIVE_SUPABASE","LIVE_VERCEL","VINCE_DIRECTIVE","VINCE_PERSONAL_OBSERVATION_REF","TOOL_REQUEST","TOOL_RESULT","UI_TRACE","RESEARCH_SOURCE","EXTERNAL_DOCUMENT","MODEL_RESPONSE","DERIVED_SUMMARY","INFERRED"]}},
    "evidence_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["USER_TRIGGER","FAILED_RESPONSE","TOOL_INPUT","TOOL_RESULT","USER_CORRECTION","DIRECT_OBSERVATION","AUTHORITATIVE_READBACK","DIAGNOSIS_SUPPORT","DIAGNOSIS_REFUTATION","REPAIR_ATTEMPT","POSTCONDITION_PROOF","REGRESSION_PROOF","PARENT_CONTEXT","MECHANISM_TRACE","TIMING_TRACE","SOURCE_ROLE_PROOF","CONFLICTING_EVIDENCE"]}},
    "discrepancy_states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["OPEN","RESOLVED_BY_NEW_EVIDENCE","RESOLVED_BY_VINCE_CORRECTION","RESOLVED_BY_AUTHORITATIVE_READBACK","UNRESOLVED"]}},
    "parent_binding":{"type":"object","additionalProperties":false,"required":["required_identity_fields","required_origin_classes"],"properties":{"required_origin_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["ACTIVE_GOAL_WORK","RECOVERY_DETOUR"]}},"required_identity_fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["root_goal_id","parent_goal_id"]}}}},
    "cross_links":{"type":"object","additionalProperties":false,"required":["checkpoint_policy","goal_root_identity_link_state","goal_root_identity_owner_path","issue_consolidation_policy","problem_intake_policy","root_cause_repair_policy","semantic_firewall_contract_path","semantic_firewall_link_state","user_observation_ledger","user_observation_policy","work_selection_policy"],"properties":{"root_cause_repair_policy":{"type":"string","const":"governance/root-cause-repair-policy.json"},"problem_intake_policy":{"type":"string","const":"governance/problem-intake-policy.json"},"work_selection_policy":{"type":"string","const":"governance/work-selection-policy.json"},"checkpoint_policy":{"type":"string","const":"continuity/checkpoint-policy.json"},"issue_consolidation_policy":{"type":"string","const":"governance/issue-consolidation-policy.json"},"user_observation_policy":{"type":"string","const":"governance/user-observation-policy.json"},"user_observation_ledger":{"type":"string","const":"continuity/user-observations.jsonl"},"semantic_firewall_contract_path":{"type":["string","null"]},"semantic_firewall_link_state":{"type":"string","enum":["PENDING_MIGRATION","ACTIVE"]},"goal_root_identity_owner_path":{"type":["string","null"]},"goal_root_identity_link_state":{"type":"string","enum":["PENDING_IMPLEMENTATION","ACTIVE"]}}},
    "source_artifacts":{"type":"object","additionalProperties":false,"required":["compatibility_map","invariants","operation_catalog","postconditions","recovery_policy"],"properties":{"invariants":{"type":"string","const":"reliability/invariants.json"},"operation_catalog":{"type":"string","const":"reliability/operation-catalog.json"},"postconditions":{"type":"string","const":"reliability/postconditions.json"},"recovery_policy":{"type":"string","const":"reliability/recovery-policy.json"},"compatibility_map":{"type":"string","const":"reliability/compatibility-map.json"}}}
  }
}
