{
  "schema_version": 1,
  "policy_id": "life-engineering-root-cause-repair-v1",
  "runtime_control_authority": "NONE",
  "scope": "ENGINEERING_REPAIR_PROCEDURE_AFTER_WORK_SELECTION",
  "problem_intake_relationship": "THIS_POLICY_GOVERNS_REPAIR_DESIGN_AND_VERIFICATION_AFTER_A_REPAIR_OPERATION_IS_SELECTED;IT_DOES_NOT_CREATE_AUTHORIZATION_PRIORITY_ROUTING_OR_RUNTIME_CONTROL",
  "trigger": "A_DETERMINISTIC_FAILURE_OR_VERIFIED_DEFECT_IS_SELECTED_FOR_REPAIR",
  "states": [
    "FAILURE_OBSERVED",
    "INVARIANT_IDENTIFIED",
    "ORIGIN_TRACED",
    "DEPENDENCIES_ENUMERATED",
    "ROOT_MECHANISM_SELECTED",
    "RECURRENCE_FALSIFICATION_DEFINED",
    "REPAIRING",
    "VERIFYING",
    "VERIFIED_FIXED",
    "BLOCKED"
  ],
  "required_trace_fields": [
    "repair_id",
    "root_goal_ref",
    "failure_refs",
    "violated_invariant_ids",
    "origin_commit_refs",
    "root_cause_classes",
    "affected_surfaces",
    "dependent_validator_surfaces",
    "selected_dispositions",
    "recurrence_test_ids",
    "verification_state"
  ],
  "history_trace_rule": "FOR_EACH_FAILURE_TRACE_REPOSITORY_HISTORY_UNTIL_THE_FAILED_MECHANISM_OR_ITS_ENABLING_PATTERN_IS_FIRST_PRESENT;IF_HISTORY_DOES_NOT_DETERMINE_AN_ORIGIN_STORE_ORIGIN_AS_UNKNOWN_AND_STATE_BLOCKED",
  "patch_only_rule": "A_CHANGE_THAT_ONLY_EDITS_A_FAILING_EXPECTATION_DETECTOR_OR_STORED_DERIVED_VALUE_CANNOT_REACH_VERIFIED_FIXED_UNLESS_ROOT_CAUSE_CLASS_IS_DETECTOR_DEFECT_AND_AN_INDEPENDENT_FALSIFICATION_FAILS_ON_THE_PRE_REPAIR_DETECTOR_AND_PASSES_ON_THE_REPAIRED_DETECTOR",
  "test_isolation_rule": "EXPECTED_VALUES_FOR_MUTABLE_CANONICAL_STATE_MUST_BE_PRODUCED_FROM_CONTROLLED_TEST_FIXTURES_OR_AN_INDEPENDENT_DERIVATION;A_LITERAL_SNAPSHOT_OF_CURRENT_PRODUCTION_STATE_IS_FORBIDDEN_AS_THE_EXPECTED_VALUE",
  "derived_state_rule": "WHEN_A_FAILURE_INVOLVES_A_VALUE_DERIVED_FROM_ANOTHER_CANONICAL_SOURCE_REPLACE_MANUAL_DUPLICATION_WITH_RUNTIME_PROJECTION_DETERMINISTIC_GENERATION_OR_EXECUTABLE_CURRENT_SOURCE_COMPATIBILITY_VALIDATION",
  "dependency_rule": "WHEN_A_REPAIR_CHANGES_A_SOURCE_CONSUMED_BY_ANOTHER_VALIDATOR_ENUMERATE_EVERY_CONSUMING_VALIDATOR_FOUND_BY_REPOSITORY_PATH_OR_SYMBOL_SEARCH_AND_UPDATE_THE_CONSUMER_OR_RECORD_AN_EXECUTABLE_TEST_PROVING_NO_CONSUMER_CHANGE_IS_REQUIRED",
  "detector_change_rule": "IF_THE_ORIGINAL_DETECTOR_ACCEPTANCE_ASSERTION_OR_VERIFICATION_CONDITION_CHANGES_REQUIRE_AN_INDEPENDENT_FALSIFICATION_THAT_FAILS_ON_THE_PRE_REPAIR_MECHANISM_AND_PASSES_ON_THE_REPAIRED_MECHANISM",
  "completion_requires": [
    "ROOT_CAUSE_RECORD_SCHEMA_VALID",
    "EVERY_FAILURE_HAS_EXACT_VIOLATED_INVARIANT_ID",
    "EVERY_FAILURE_HAS_ORIGIN_COMMIT_OR_BLOCKED_UNKNOWN_ORIGIN",
    "EVERY_AFFECTED_SURFACE_IS_ENUMERATED",
    "EVERY_DEPENDENT_VALIDATOR_SURFACE_IS_ENUMERATED",
    "EVERY_SELECTED_DISPOSITION_IS_KEEP_REPLACE_MODIFY_COMBINE_OR_REMOVE",
    "RECURRENCE_FALSIFICATION_PASSES",
    "ORIGINAL_FAILURE_DETECTOR_RERUN_PASSES",
    "FULL_REQUIRED_REPOSITORY_VALIDATION_PASSES",
    "PROTECTED_INTEGRATION_AND_REQUIRED_LIVE_READBACK_PASS"
  ],
  "forbidden_terminal_shortcuts": [
    "PATCH_EXPECTED_LITERAL_ONLY",
    "REFRESH_DERIVED_HASH_ONLY",
    "DISABLE_OR_WEAKEN_DETECTOR_WITHOUT_INDEPENDENT_FALSIFICATION",
    "MARK_FIXED_FROM_PROSE_REVIEW_OR_MODEL_JUDGMENT",
    "SKIP_DEPENDENT_VALIDATOR_ENUMERATION"
  ],
  "durability_rule": "EVERY_NONTERMINAL_ROOT_CAUSE_REPAIR_MUST_HAVE_A_VERSIONED_RECORD_DISCOVERABLE_FROM_BOOTSTRAP_REQUIRED_SOURCE",
  "terminal_rule": "VERIFIED_FIXED_IS_ALLOWED_ONLY_WHEN_EVERY_COMPLETION_REQUIRES_ENTRY_IS_MACHINE_VERIFIED"
}
