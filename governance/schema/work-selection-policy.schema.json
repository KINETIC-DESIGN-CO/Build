{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/governance/schema/work-selection-policy.schema.json",
  "title": "Life Engineering Work Selection Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "continuity_integration",
    "engineering_work_selection_authority",
    "evidence_contract",
    "foreground_blocker_rule",
    "fresh_thread_dispatch",
    "interruption",
    "novelty_rule",
    "parallel_admission",
    "parallel_rule",
    "policy_id",
    "preemption_rule",
    "priority_order",
    "rank_semantics",
    "runtime_control_authority",
    "same_or_lower_priority_rule",
    "schema_version",
    "worker_lanes"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "policy_id": {
      "const": "life-engineering-work-selection-v4"
    },
    "runtime_control_authority": {
      "const": "NONE"
    },
    "engineering_work_selection_authority": {
      "const": "DETERMINISTIC_EVALUATION_ONLY"
    },
    "worker_lanes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FOREGROUND",
          "PARALLEL_ASSIGNED"
        ]
      }
    },
    "rank_semantics": {
      "const": "LOWER_NUMERIC_RANK_HAS_HIGHER_PRECEDENCE"
    },
    "priority_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "rank",
          "selected_work"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 0
          },
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "selected_work": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preemption_rule": {
      "type": "string",
      "minLength": 1
    },
    "same_or_lower_priority_rule": {
      "type": "string",
      "minLength": 1
    },
    "novelty_rule": {
      "type": "string",
      "minLength": 1
    },
    "continuity_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_rule",
        "evidence_effect",
        "global_claim_effect",
        "global_claim_resource_key",
        "live_hydration_rule",
        "main_integration_rule",
        "mode",
        "projection_rule",
        "source_mutation_rule",
        "update_event_rule"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "global_claim_resource_key": {
          "type": "null"
        },
        "global_claim_effect": {
          "type": "string",
          "minLength": 1
        },
        "update_event_rule": {
          "type": "string",
          "minLength": 1
        },
        "source_mutation_rule": {
          "type": "string",
          "minLength": 1
        },
        "main_integration_rule": {
          "type": "string",
          "minLength": 1
        },
        "conflict_rule": {
          "type": "string",
          "minLength": 1
        },
        "projection_rule": {
          "type": "string",
          "minLength": 1
        },
        "live_hydration_rule": {
          "type": "string",
          "minLength": 1
        },
        "evidence_effect": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume_cue_effect",
        "resume_rule",
        "terminal_states",
        "unresolved_states"
      ],
      "properties": {
        "unresolved_states": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terminal_states": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resume_cue_effect": {
          "type": "string",
          "minLength": 1
        },
        "resume_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foreground_blocker_rule": {
      "type": "string",
      "minLength": 1
    },
    "parallel_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_state",
        "authorization_event_result",
        "authorization_event_type",
        "authorization_target_any",
        "complete_state",
        "dependency_rule",
        "issue_authority_rule",
        "registry_path",
        "removed_state",
        "schema_path",
        "tie_break_rule",
        "unavailable_rule"
      ],
      "properties": {
        "registry_path": {
          "type": "string",
          "minLength": 1
        },
        "schema_path": {
          "type": "string",
          "minLength": 1
        },
        "admitted_state": {
          "type": "string",
          "minLength": 1
        },
        "complete_state": {
          "type": "string",
          "minLength": 1
        },
        "removed_state": {
          "type": "string",
          "minLength": 1
        },
        "authorization_event_type": {
          "type": "string",
          "minLength": 1
        },
        "authorization_event_result": {
          "type": "string",
          "minLength": 1
        },
        "authorization_target_any": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tie_break_rule": {
          "type": "string",
          "minLength": 1
        },
        "dependency_rule": {
          "type": "string",
          "minLength": 1
        },
        "unavailable_rule": {
          "type": "string",
          "minLength": 1
        },
        "issue_authority_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parallel_rule": {
      "type": "string",
      "minLength": 1
    },
    "fresh_thread_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity_rule",
        "foreground_selection_rule",
        "lane_rule",
        "missing_lock_rule",
        "mode",
        "parallel_selection_rule",
        "race_rule",
        "resource_rule",
        "snapshot_required_resource_rule",
        "worker_lane_input_rule"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "worker_lane_input_rule": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_required_resource_rule": {
          "type": "string",
          "minLength": 1
        },
        "lane_rule": {
          "type": "string",
          "minLength": 1
        },
        "foreground_selection_rule": {
          "type": "string",
          "minLength": 1
        },
        "parallel_selection_rule": {
          "type": "string",
          "minLength": 1
        },
        "race_rule": {
          "type": "string",
          "minLength": 1
        },
        "resource_rule": {
          "type": "string",
          "minLength": 1
        },
        "continuity_rule": {
          "type": "string",
          "minLength": 1
        },
        "missing_lock_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status",
        "interrupted_operation_state",
        "parallel_request_state",
        "parallel_resource_intersection",
        "parallel_work_item_id_pattern",
        "required_fields",
        "selected_rank_before",
        "selected_work_terminal",
        "worker_lane"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worker_lane": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interrupted_operation_state": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_status": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parallel_request_state": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parallel_resource_intersection": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_rank_before": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {}
        },
        "selected_work_terminal": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {}
        },
        "parallel_work_item_id_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
