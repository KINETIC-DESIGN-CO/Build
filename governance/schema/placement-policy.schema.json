{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Governance Placement Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "runtime_control_authority",
    "purpose",
    "input_states",
    "pre_mutation_issue_review",
    "routing_algorithm",
    "routing_precedence",
    "control_decision_kinds",
    "destinations",
    "canonical_owner_rule",
    "proposal_rule",
    "unrouted_rule",
    "project_instruction_change_rule",
    "runtime_control_rule",
    "migration_candidates",
    "project_instruction_root_blocks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "life-governance-placement-v1"
    },
    "runtime_control_authority": {
      "const": "NONE"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "input_states": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pre_mutation_issue_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "source",
        "required_steps",
        "issue_effect"
      ],
      "properties": {
        "trigger": {
          "const": "BEFORE_STARTING_OR_RESUMING_MUTABLE_LIFE_REPOSITORY_WORK"
        },
        "source": {
          "const": "ALL_OPEN_ISSUES_IN_AUTHORIZED_GITHUB_REPOSITORY"
        },
        "required_steps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issue_effect": {
          "const": "EVIDENCE_ONLY_NEVER_AUTHORIZATION_LOCK_CLAIM_COMPLETION_RELEASE_OR_MERGE_GATE"
        }
      }
    },
    "routing_algorithm": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routing_precedence": {
      "const": [
        "EXECUTABLE_CONTROL",
        "PROJECT_INSTRUCTIONS_ROOT",
        "RESPONSE_CONTRACT",
        "GOVERNANCE_POLICY",
        "CONTINUITY_CURRENT",
        "CONTINUITY_DECISION",
        "CONTINUITY_EVENT",
        "COMPONENT_SPECIFICATION",
        "PROPOSAL_INTAKE",
        "UNROUTED"
      ]
    },
    "control_decision_kinds": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "destinations": {
      "const": {
        "EXECUTABLE_CONTROL": {
          "canonical_owner": "EXECUTABLE_MECHANISM_WITH_VERSIONED_SOURCE_AND_TESTS",
          "match_condition_ids": [
            "RUNTIME_CONTROL_DECISION_KIND"
          ],
          "authority": "MACHINE_VERIFIABLE_CONTROL_ONLY"
        },
        "PROJECT_INSTRUCTIONS_ROOT": {
          "canonical_owner": "PROJECT_INSTRUCTIONS",
          "match_condition_ids": [
            "AUTHORIZED_SYSTEM_IDENTITY",
            "MANDATORY_BOOTSTRAP_LOADER",
            "PROJECT_INSTRUCTION_EDIT_PROTECTION",
            "PROJECT_INSTRUCTION_LENGTH_PROTECTION",
            "COST_COMMITMENT_AUTHORIZATION_ROOT"
          ],
          "authority": "ASSISTANT_PROCEDURE_ROOT_ONLY"
        },
        "RESPONSE_CONTRACT": {
          "canonical_owner": "continuity/response-contract.json",
          "match_condition_ids": [
            "ASSISTANT_TO_VINCE_PRESENTATION_BEHAVIOR"
          ],
          "authority": "ASSISTANT_PROCEDURE_ONLY"
        },
        "GOVERNANCE_POLICY": {
          "canonical_owner": "BOOTSTRAP_REQUIRED_GOVERNANCE_POLICY",
          "match_condition_ids": [
            "PLACEMENT_PROCEDURE",
            "PRE_RESPONSE_RESEARCH_PROCEDURE",
            "FACT_VERIFICATION_PROCEDURE",
            "REEVALUATION_PROCEDURE",
            "CONNECTED_APP_MUTATION_PROCEDURE",
            "VERSIONING_PROCEDURE",
            "SOURCE_COORDINATION_PROCEDURE",
            "PROJECT_INSTRUCTION_STATE_REVIEW_PROCEDURE",
            "OPEN_ISSUE_REVIEW_PROCEDURE"
          ],
          "authority": "ASSISTANT_PROCEDURE_ONLY"
        },
        "CONTINUITY_CURRENT": {
          "canonical_owner": "continuity/current.json",
          "match_condition_ids": [
            "CURRENT_STATE",
            "CURRENT_NEXT_ACTION",
            "CURRENT_BLOCKER",
            "CURRENT_VERIFICATION_SNAPSHOT"
          ],
          "authority": "CANONICAL_ENGINEERING_CONTINUITY_STATE_ONLY"
        },
        "CONTINUITY_DECISION": {
          "canonical_owner": "continuity/decisions.jsonl",
          "match_condition_ids": [
            "ADOPTED_ARCHITECTURE_DECISION"
          ],
          "authority": "CANONICAL_ENGINEERING_DECISION_HISTORY_ONLY"
        },
        "CONTINUITY_EVENT": {
          "canonical_owner": "continuity/events.jsonl",
          "match_condition_ids": [
            "OCCURRED_EVENT"
          ],
          "authority": "CANONICAL_ENGINEERING_EVENT_HISTORY_ONLY"
        },
        "COMPONENT_SPECIFICATION": {
          "canonical_owner": "VERSIONED_COMPONENT_ARCHITECTURE_CONTRACT_SCHEMA_OR_SOURCE",
          "match_condition_ids": [
            "COMPONENT_LOCAL_TECHNICAL_CONTRACT"
          ],
          "authority": "COMPONENT_SPECIFICATION_ONLY"
        },
        "PROPOSAL_INTAKE": {
          "canonical_owner": "ZERO_AUTHORITY_PROPOSAL_RECORD",
          "match_condition_ids": [],
          "authority": "ZERO"
        },
        "UNROUTED": {
          "canonical_owner": "NONE",
          "match_condition_ids": [],
          "authority": "ZERO"
        }
      }
    },
    "canonical_owner_rule": {
      "type": "string",
      "minLength": 1
    },
    "proposal_rule": {
      "type": "string",
      "minLength": 1
    },
    "unrouted_rule": {
      "type": "string",
      "minLength": 1
    },
    "project_instruction_change_rule": {
      "type": "string",
      "minLength": 1
    },
    "runtime_control_rule": {
      "type": "string",
      "minLength": 1
    },
    "migration_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "project_instruction_root_blocks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
