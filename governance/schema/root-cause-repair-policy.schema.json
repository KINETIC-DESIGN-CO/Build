{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/governance/schema/root-cause-repair-policy.schema.json",
  "title": "Life Engineering Root Cause Repair Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "completion_requires",
    "dependency_rule",
    "derived_state_rule",
    "detector_change_rule",
    "durability_rule",
    "forbidden_terminal_shortcuts",
    "history_trace_rule",
    "patch_only_rule",
    "policy_id",
    "problem_intake_relationship",
    "required_trace_fields",
    "runtime_control_authority",
    "schema_version",
    "scope",
    "states",
    "terminal_rule",
    "test_isolation_rule",
    "trigger"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-engineering-root-cause-repair-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "scope": {"const": "ENGINEERING_REPAIR_PROCEDURE_AFTER_WORK_SELECTION"},
    "problem_intake_relationship": {"type": "string", "minLength": 1},
    "trigger": {"const": "A_DETERMINISTIC_FAILURE_OR_VERIFIED_DEFECT_IS_SELECTED_FOR_REPAIR"},
    "states": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_trace_fields": {"type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "history_trace_rule": {"type": "string", "minLength": 1},
    "patch_only_rule": {"type": "string", "minLength": 1},
    "test_isolation_rule": {"type": "string", "minLength": 1},
    "derived_state_rule": {"type": "string", "minLength": 1},
    "dependency_rule": {"type": "string", "minLength": 1},
    "detector_change_rule": {"type": "string", "minLength": 1},
    "completion_requires": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_terminal_shortcuts": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "durability_rule": {"type": "string", "minLength": 1},
    "terminal_rule": {"type": "string", "minLength": 1}
  }
}
