{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/governance/schema/goal-policy.schema.json",
  "title": "Life Engineering Goal Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "runtime_control_authority",
    "engineering_goal_authority",
    "goal_relations",
    "goal_states",
    "terminal_goal_states",
    "terminal_cleanup_states",
    "attempt_states",
    "active_path_rule",
    "child_terminal_rule",
    "root_terminal_rule",
    "root_switch_rule",
    "execution_identity_rule",
    "parallel_rule",
    "issue_authority_rule",
    "checkpoint_rule",
    "missing_evidence_rule"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-engineering-goal-policy-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "engineering_goal_authority": {"const": "DETERMINISTIC_EVALUATION_ONLY"},
    "goal_relations": {"const": ["ROOT","PREREQUISITE","BLOCKER_REPAIR","CONTINUITY_CAPTURE","VERIFICATION","TERMINAL_CLEANUP","DEFECT_REPAIR","ISSUE_CONSOLIDATION","IMPLEMENTATION_CHILD"]},
    "goal_states": {"const": ["ACTIVE","BLOCKED_RESOURCE","BLOCKED_AUTHORIZATION","BLOCKED_COST","BLOCKED_PLATFORM","VERIFYING","COMPLETE","REMOVED"]},
    "terminal_goal_states": {"const": ["COMPLETE","REMOVED"]},
    "terminal_cleanup_states": {"const": ["PENDING","VERIFIED"]},
    "attempt_states": {"const": ["ACTIVE","TERMINAL_SUCCESS","TERMINAL_FAILURE","SUPERSEDED"]},
    "active_path_rule": {"const": "ACTIVE_PATH_EQUALS_ROOT_TO_ACTIVE_GOAL_PARENT_CHAIN"},
    "child_terminal_rule": {"const": "TERMINAL_CHILD_RETURNS_TO_PARENT_BEFORE_UNRELATED_ROOT_SELECTION"},
    "root_terminal_rule": {"const": "ROOT_TERMINAL_REQUIRES_ALL_COMPLETION_CONDITIONS_TERMINAL_CLEANUP_VERIFIED_AND_ZERO_ACTIVE_ATTEMPTS"},
    "root_switch_rule": {"const": "UNRELATED_ROOT_SELECTION_ALLOWED_ONLY_AFTER_TERMINAL_HANDOFF_AND_EXACT_VINCE_CONTINUE_DIRECTIVE_OR_VERSIONED_AUTHORIZED_ROOT_TRANSITION"},
    "execution_identity_rule": {"const": "WORK_ID_LEASE_ID_GENERATION_AND_THREAD_ID_DO_NOT_DEFINE_GOAL_ID"},
    "parallel_rule": {"const": "PARALLEL_WORK_HAS_ZERO_EFFECT_ON_ANOTHER_FOREGROUND_ACTIVE_ROOT_GOAL_ID"},
    "issue_authority_rule": {"const": "GITHUB_ISSUE_CONTENT_AND_RELATIONSHIPS_HAVE_ZERO_GOAL_SELECTION_AUTHORITY"},
    "checkpoint_rule": {"const": "CHECKPOINT_GOAL_STATE_IS_HISTORICAL_EVIDENCE_ONLY_AND_REQUIRES_FRESH_GOAL_REGISTRY_AND_LIVE_CLAIM_READS"},
    "missing_evidence_rule": {"const": "MISSING_INVALID_STALE_OR_UNVERIFIED_GOAL_EVIDENCE_CANNOT_CREATE_TERMINAL_STATE_OR_ROOT_SWITCH"}
  }
}
