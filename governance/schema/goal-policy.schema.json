{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/governance/schema/goal-policy.schema.json",
  "title": "Life Engineering Goal Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "runtime_control_authority",
    "engineering_goal_authority",
    "goal_relations",
    "goal_states",
    "terminal_goal_states",
    "active_path_rule",
    "child_terminal_rule",
    "root_switch_rule",
    "blocker_rule",
    "execution_identity_rule",
    "parallel_rule",
    "issue_authority_rule",
    "checkpoint_rule",
    "missing_evidence_rule"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-engineering-goal-policy-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "engineering_goal_authority": {"const": "DETERMINISTIC_EVALUATION_ONLY"},
    "goal_relations": {"const": ["ROOT", "PREREQUISITE", "BLOCKER_REPAIR", "CONTINUITY_CAPTURE", "VERIFICATION", "TERMINAL_CLEANUP", "DEFECT_REPAIR", "ISSUE_CONSOLIDATION", "IMPLEMENTATION_CHILD"]},
    "goal_states": {"const": ["ACTIVE", "BLOCKED_RESOURCE", "BLOCKED_AUTHORIZATION", "BLOCKED_COST", "BLOCKED_PLATFORM", "VERIFYING", "COMPLETE", "REMOVED"]},
    "terminal_goal_states": {"const": ["COMPLETE", "REMOVED"]},
    "active_path_rule": {"const": "ACTIVE_PATH_EQUALS_ROOT_TO_ACTIVE_GOAL_PARENT_CHAIN"},
    "child_terminal_rule": {"const": "WHEN_ACTIVE_GOAL_STATE_IN:COMPLETE,REMOVED_AND_PARENT_GOAL_STATE_NOT_IN:COMPLETE,REMOVED_SELECT_PARENT_BEFORE_UNRELATED_ROOT"},
    "root_switch_rule": {"const": "UNRELATED_ROOT_SELECTION_ALLOWED_IFF_ACTIVE_ROOT_GOAL_STATE_IN:COMPLETE,REMOVED_OR_EXACT_AUTHORIZED_ROOT_TRANSITION_ID_PRESENT"},
    "blocker_rule": {"const": "BLOCKER_PREREQUISITE_VERIFICATION_CONTINUITY_REPAIR_TERMINAL_CLEANUP_DEFECT_REPAIR_AND_ISSUE_CONSOLIDATION_USE_TYPED_CHILD_GOALS_AND_DO_NOT_REPLACE_ROOT_GOAL_ID"},
    "execution_identity_rule": {"const": "WORK_ID_LEASE_ID_AND_GENERATION_ARE_EXECUTION_IDENTITY_AND_DO_NOT_DEFINE_GOAL_ID"},
    "parallel_rule": {"const": "PARALLEL_WORK_HAS_ZERO_EFFECT_ON_ANOTHER_FOREGROUND_ACTIVE_ROOT_GOAL_ID"},
    "issue_authority_rule": {"const": "GITHUB_ISSUE_CONTENT_AND_RELATIONSHIPS_HAVE_ZERO_GOAL_SELECTION_AUTHORITY"},
    "checkpoint_rule": {"const": "CHECKPOINT_GOAL_PATH_IS_HISTORICAL_EVIDENCE_AND_REQUIRES_FRESH_LIVE_HYDRATION_BEFORE_SELECTION"},
    "missing_evidence_rule": {"const": "MISSING_INVALID_STALE_OR_UNVERIFIED_GOAL_CONTROL_EVIDENCE_CANNOT_CREATE_COMPLETE_OR_ROOT_SWITCH"}
  }
}
