{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/governance/schema/issue-lifecycle-policy.schema.json",
  "title": "Life GitHub Issue Lifecycle Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorized_repository",
    "failure_rule",
    "issue_state_source",
    "native_close_mode",
    "native_link_rule",
    "nonterminal_admission_state",
    "policy_id",
    "reconciliation_rules",
    "reconciliation_trigger",
    "redispatch_binding",
    "registry_path",
    "runtime_control_authority",
    "schema_version",
    "scope",
    "states",
    "terminal_admission_states",
    "terminal_binding",
    "workflow_path"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-github-issue-lifecycle-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "scope": {"const": "GITHUB_ENGINEERING_VISIBILITY_ONLY"},
    "authorized_repository": {"const": "KINETIC-DESIGN-CO/Build"},
    "registry_path": {"const": "governance/work-admissions.json"},
    "workflow_path": {"const": ".github/workflows/issue-lifecycle.yml"},
    "issue_state_source": {"const": "AUTHORITATIVE_GITHUB_ISSUE_READBACK"},
    "native_close_mode": {"const": "COMBINE_LINKED_PR_AUTO_CLOSE_WITH_REPOSITORY_RECONCILIATION"},
    "terminal_admission_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["COMPLETE", "REMOVED"],
      "properties": {
        "COMPLETE": {"const": "completed"},
        "REMOVED": {"const": "not_planned"}
      }
    },
    "nonterminal_admission_state": {"const": "ADMITTED"},
    "reconciliation_trigger": {"const": "EVERY_PUSH_TO_MAIN_AND_EXPLICIT_WORKFLOW_DISPATCH"},
    "reconciliation_rules": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "terminal_binding": {"const": "ADMITTED_ISSUE_SELECTED_WORK_TERMINAL_TRUE_ONLY_IF_ADMISSION_STATE_IS_COMPLETE_OR_REMOVED_AND_GITHUB_ISSUE_CLOSED_STATE_READBACK_IS_VERIFIED_WITH_MAPPED_REASON"},
    "redispatch_binding": {"const": "TERMINAL_REDISPATCH_MAY_RUN_ONLY_AFTER_TERMINAL_BINDING_IS_TRUE_FOR_THE_COMPLETED_ADMITTED_ISSUE"},
    "native_link_rule": {"const": "A_DEFAULT_BRANCH_PULL_REQUEST_MAY_USE_A_GITHUB_SUPPORTED_CLOSING_LINK_BUT_NATIVE_CLOSE_DOES_NOT_REPLACE_AUTHORITATIVE_READBACK"},
    "failure_rule": {"const": "OPEN_OR_UNREADABLE_OR_WRONG_REASON_GITHUB_ISSUE_FOR_TERMINAL_ADMISSION_RETURNS_NONTERMINAL_CLEANUP_STATE"},
    "states": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ADMISSION_NONTERMINAL",
          "CLOSE_REQUIRED",
          "REASON_RECONCILIATION_REQUIRED",
          "READBACK_NOT_RUN",
          "VERIFIED_TERMINAL"
        ]
      }
    }
  }
}
