{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinanonymous/Build/blob/main/governance/schema/work-admissions.schema.json",
  "title": "Life Engineering Work Admissions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_ref",
    "engineering_work_selection_authority",
    "items",
    "registry_id",
    "runtime_control_authority",
    "schema_version",
    "source_repository",
    "tie_break_rule"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "const": "life-engineering-work-admissions-v1"
    },
    "runtime_control_authority": {
      "const": "NONE"
    },
    "engineering_work_selection_authority": {
      "const": "DETERMINISTIC_EVALUATION_ONLY"
    },
    "authorization_ref": {
      "type": "string",
      "pattern": "^E-[0-9]{4}$"
    },
    "source_repository": {
      "const": "Vinanonymous/Build"
    },
    "tie_break_rule": {
      "const": "DISPATCH_TIER_ASC_SOURCE_ISSUE_ASC_WORK_ITEM_ID_ASC"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "depends_on",
          "dispatch_tier",
          "source_issue_number",
          "state",
          "work_item_id"
        ],
        "properties": {
          "work_item_id": {
            "type": "string",
            "pattern": "^github-issue-[1-9][0-9]*$"
          },
          "source_issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "component_id": {
            "type": "string",
            "pattern": "^issue_[1-9][0-9]*$"
          },
          "dispatch_tier": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "ADMITTED",
              "COMPLETE",
              "REMOVED"
            ]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^github-issue-[1-9][0-9]*$"
            }
          }
        }
      }
    }
  }
}
