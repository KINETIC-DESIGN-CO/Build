{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Problem Intake and Resolution Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "runtime_control_authority",
    "assistant_procedure_authority",
    "intake",
    "problem_evaluation",
    "continuity_integration"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-problem-intake-and-resolution-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "assistant_procedure_authority": {"const": "ASSISTANT_PROCEDURE_ONLY"},
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "title_prefix",
        "intake_authority",
        "input_classes",
        "create_exemption_id",
        "create_exemption_conditions",
        "create_exemption_effect",
        "problem_identity_rule",
        "dedupe_rule",
        "projection_rule",
        "edit_rule"
      ],
      "properties": {
        "provider": {"const": "GITHUB_ISSUE"},
        "repository": {"const": "KINETIC-DESIGN-CO/Build"},
        "title_prefix": {"const": "[LIFE-INTAKE] "},
        "intake_authority": {"const": "ZERO"},
        "input_classes": {
          "const": ["VINCE_DIRECTIVE","VINCE_CORRECTION","PROBLEM_CANDIDATE","VERIFIED_DEFECT"]
        },
        "create_exemption_id": {"const": "ZERO_AUTHORITY_INTAKE_ISSUE_CREATE"},
        "create_exemption_conditions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "create_exemption_effect": {"const": "INTAKE_ISSUE_IS_DURABLE_ZERO_AUTHORITY_EVIDENCE_AND_DOES_NOT_REQUIRE_IMMEDIATE_CANONICAL_CONTINUITY_PROJECTION"},
        "problem_identity_rule": {"type":"string","minLength":1},
        "dedupe_rule": {"type":"string","minLength":1},
        "projection_rule": {"type": "string", "minLength": 1},
        "edit_rule": {"type": "string", "minLength": 1}
      }
    },
    "problem_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "required_steps",
        "states",
        "verified_defect_evidence_classes",
        "remove_rule",
        "keep_rule",
        "repair_rule",
        "blocked_evidence_rule",
        "repair_item_rule",
        "bootstrap_effect",
        "no_passive_outcome_rule",
        "completion_rule"
      ],
      "properties": {
        "trigger": {"const": "AFTER_ANY_OBSERVED_SYSTEM_ERROR_BLOCKER_FRICTION_OR_STALE_MECHANISM"},
        "required_steps": {"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "states": {"type":"array","minItems":14,"maxItems":14,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "verified_defect_evidence_classes": {
          "const": [
            "REQUIRED_CHECK_FAILURE",
            "SCHEMA_OR_INVARIANT_VIOLATION",
            "AUTHORITATIVE_LIVE_MISMATCH",
            "VERSIONED_FALSIFICATION_FAILURE",
            "VERIFIED_PLATFORM_INCOMPATIBILITY"
          ]
        },
        "remove_rule": {"type":"string","minLength":1},
        "keep_rule": {"type":"string","minLength":1},
        "repair_rule": {"type":"string","minLength":1},
        "blocked_evidence_rule": {"type":"string","minLength":1},
        "repair_item_rule": {"type":"string","minLength":1},
        "bootstrap_effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execute_before_work_selection_states",
            "execute_before_work_selection_effect",
            "continue_to_work_selection_states",
            "continue_to_work_selection_effect",
            "preserve_without_drop_states",
            "preserve_without_drop_effect"
          ],
          "properties": {
            "execute_before_work_selection_states": {"const":["REPAIR_REQUIRED","REMOVE_REQUIRED"]},
            "execute_before_work_selection_effect": {"const":"EXECUTE_OR_ENTER_ONE_EXACT_BLOCKED_STATE_BEFORE_EVALUATE_WORK_SELECTION"},
            "continue_to_work_selection_states": {"const":["KEEP_REQUIRED","VERIFIED_FIXED","VERIFIED_REMOVED","REJECTED_NOT_PROBLEM"]},
            "continue_to_work_selection_effect": {"const":"CONTINUE_TO_EVALUATE_WORK_SELECTION"},
            "preserve_without_drop_states": {"const":["PROBLEM_CANDIDATE","VERIFIED_DEFECT","BLOCKED_RESOURCE","BLOCKED_AUTHORIZATION","BLOCKED_COST","BLOCKED_PLATFORM","BLOCKED_EVIDENCE","VERIFYING"]},
            "preserve_without_drop_effect": {"const":"PRESERVE_STATE_AND_DO_NOT_DROP_THE_PROBLEM"}
          }
        },
        "no_passive_outcome_rule": {"type":"string","minLength":1},
        "completion_rule": {"type":"string","minLength":1}
      }
    },
    "continuity_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "global_claim_resource_key",
        "global_claim_effect",
        "intake_issue_rule",
        "canonical_projection_rule",
        "legacy_claim_rule"
      ],
      "properties": {
        "mode": {"const": "WORK_BRANCH_CAPTURE_PLUS_PROTECTED_MERGE"},
        "global_claim_resource_key": {"const": null},
        "global_claim_effect": {"const": "NONE"},
        "intake_issue_rule": {"const": "ZERO_AUTHORITY_INTAKE_ISSUE_CREATE_IS_DURABLE_EVIDENCE_AND_HAS_ZERO_WORK_SELECTION_PREEMPTION_EFFECT"},
        "canonical_projection_rule": {"const": "REPOSITORY_CONTINUITY_CHANGES_ARE_CAPTURED_ON_WORK_BRANCHES_AND_REACH_MAIN_ONLY_THROUGH_REQUIRED_VALIDATE_AND_GITHUB_MERGE_QUEUE"},
        "legacy_claim_rule": {"const": "LEGACY_CONTINUITY_SYNC_LOCKS_HAVE_ZERO_WORK_SELECTION_LANE_OR_PREEMPTION_EFFECT"}
      }
    }
  }
}
