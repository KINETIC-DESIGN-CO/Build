{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life.local/governance/schema/live-audit-policy.schema.json",
  "title": "Life live audit repair-first policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "runtime_control_authority",
    "assistant_procedure_authority",
    "mode",
    "loop",
    "trigger_ids",
    "finding_states",
    "verified_repair_evidence_classes",
    "dispositions",
    "blocker_states",
    "repair_rule",
    "replan_rule",
    "candidate_rule",
    "queue_rule",
    "selection_binding_rule",
    "blocker_clear_rule",
    "resource_scope_rule",
    "parent_goal_rule",
    "verification_rule",
    "trust_root_rule",
    "passive_terminal_states_forbidden",
    "canonical_owner_bindings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-live-audit-repair-first-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "assistant_procedure_authority": {"const": "BOOTSTRAP_REQUIRED_GOVERNANCE"},
    "mode": {"const": "IN_RUN_EVENT_DRIVEN"},
    "loop": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trigger_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "finding_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verified_repair_evidence_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dispositions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blocker_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_state", "authorization_state", "cost_state", "platform_state", "verification_trust_state"],
      "properties": {
        "resource_state": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "authorization_state": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "cost_state": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "platform_state": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "verification_trust_state": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "repair_rule": {"type": "string", "minLength": 1},
    "replan_rule": {"type": "string", "minLength": 1},
    "candidate_rule": {"type": "string", "minLength": 1},
    "queue_rule": {"type": "string", "minLength": 1},
    "selection_binding_rule": {"type": "string", "minLength": 1},
    "blocker_clear_rule": {"type": "string", "minLength": 1},
    "resource_scope_rule": {"type": "string", "minLength": 1},
    "parent_goal_rule": {"type": "string", "minLength": 1},
    "verification_rule": {"type": "string", "minLength": 1},
    "trust_root_rule": {"type": "string", "minLength": 1},
    "passive_terminal_states_forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "canonical_owner_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_design_and_verification", "work_selection", "goal_identity", "source_coordination", "research_depth", "effect_execution"],
      "properties": {
        "repair_design_and_verification": {"type": "string", "minLength": 1},
        "work_selection": {"type": "string", "minLength": 1},
        "goal_identity": {"type": "string", "minLength": 1},
        "source_coordination": {"type": "string", "minLength": 1},
        "research_depth": {"type": "string", "minLength": 1},
        "effect_execution": {"type": "string", "minLength": 1}
      }
    }
  }
}
