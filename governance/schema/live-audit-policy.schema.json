{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life.local/governance/schema/live-audit-policy.schema.json",
  "title": "Life live worker audit repair-first policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "runtime_control_authority", "assistant_procedure_authority", "mode", "loop", "trigger_ids", "audit_dimensions", "dimension_states", "audit_result_states", "finding_states", "verified_repair_evidence_classes", "repair_lifecycle_states", "execution_dispositions", "blocker_states", "candidate_rule", "verified_repair_rule", "repair_identity_rule", "queue_rule", "selection_binding_rule", "resource_scope_rule", "parent_goal_rule", "research_binding_rule", "snapshot_invalidation_rule", "verification_rule", "effect_precedence_rule", "non_authority_rule", "passive_terminal_states_forbidden", "canonical_owner_bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-live-worker-audit-repair-first-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "assistant_procedure_authority": {"const": "BOOTSTRAP_REQUIRED_GOVERNANCE"},
    "mode": {"const": "IN_RUN_EVENT_BOUNDARY_DRIVEN"},
    "loop": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trigger_ids": {"type": "array", "minItems": 13, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "audit_dimensions": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dimension_states": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "audit_result_states": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "finding_states": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verified_repair_evidence_classes": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "repair_lifecycle_states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution_dispositions": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blocker_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_state", "authorization_state", "cost_state", "platform_state"],
      "properties": {
        "resource_state": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "authorization_state": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "cost_state": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "platform_state": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "candidate_rule": {"type": "string", "minLength": 1},
    "verified_repair_rule": {"type": "string", "minLength": 1},
    "repair_identity_rule": {"type": "string", "minLength": 1},
    "queue_rule": {"type": "string", "minLength": 1},
    "selection_binding_rule": {"type": "string", "minLength": 1},
    "resource_scope_rule": {"type": "string", "minLength": 1},
    "parent_goal_rule": {"type": "string", "minLength": 1},
    "research_binding_rule": {"type": "string", "minLength": 1},
    "snapshot_invalidation_rule": {"type": "string", "minLength": 1},
    "verification_rule": {"type": "string", "minLength": 1},
    "effect_precedence_rule": {"type": "string", "minLength": 1},
    "non_authority_rule": {"type": "string", "minLength": 1},
    "passive_terminal_states_forbidden": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "canonical_owner_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_lifecycle", "work_selection", "goal_identity", "source_coordination", "research_depth", "effect_execution"],
      "properties": {
        "repair_lifecycle": {"type": "string", "minLength": 1},
        "work_selection": {"type": "string", "minLength": 1},
        "goal_identity": {"type": "string", "minLength": 1},
        "source_coordination": {"type": "string", "minLength": 1},
        "research_depth": {"type": "string", "minLength": 1},
        "effect_execution": {"type": "string", "minLength": 1}
      }
    }
  }
}
