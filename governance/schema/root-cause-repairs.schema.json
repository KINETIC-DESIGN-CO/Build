{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/governance/schema/root-cause-repairs.schema.json",
  "title": "Life Engineering Root Cause Repair Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "repairs", "runtime_control_authority", "schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "life-engineering-root-cause-repairs-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "affected_surfaces",
          "dependent_validator_surfaces",
          "failure_refs",
          "history_evidence_refs",
          "origin_commit_refs",
          "recurrence_test_ids",
          "repair_id",
          "root_cause_classes",
          "root_goal_ref",
          "selected_dispositions",
          "state",
          "verification_state",
          "violated_invariant_ids"
        ],
        "properties": {
          "repair_id": {"type": "string", "pattern": "^RCA-[0-9]{4}$"},
          "root_goal_ref": {"type": "string", "minLength": 1},
          "state": {"enum": ["FAILURE_OBSERVED", "INVARIANT_IDENTIFIED", "ORIGIN_TRACED", "DEPENDENCIES_ENUMERATED", "ROOT_MECHANISM_SELECTED", "RECURRENCE_FALSIFICATION_DEFINED", "REPAIRING", "VERIFYING", "VERIFIED_FIXED", "BLOCKED"]},
          "failure_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "violated_invariant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
          "origin_commit_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|UNKNOWN)$"}},
          "history_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
          "root_cause_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
          "affected_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dependent_validator_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "selected_dispositions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "recurrence_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
          "verification_state": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
