{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Work Fence Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "background_heartbeat_requirement",
    "canonical_evaluator",
    "canonical_selector_entrypoint",
    "component_stale_after_seconds",
    "control_signal_rule",
    "control_signal_states",
    "engineering_fence_authority",
    "evaluation_precedence",
    "external_effect_states",
    "external_effect_unresolved_result",
    "external_effect_unresolved_states",
    "generation_fence_rule",
    "generation_mismatch_result",
    "goal_execution_attempt_binding_rule",
    "goal_execution_attempt_mismatch_result",
    "goal_revision_fence_rule",
    "goal_revision_mismatch_result",
    "legacy_v1_component_effective_expiry_rule",
    "policy_id",
    "protected_boundaries",
    "renewal_event_types",
    "runtime_control_authority",
    "scheduled_sweep_authority",
    "schema_version",
    "takeover_rule",
    "thread_wakeup_dependency"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "life-work-fence-v1"
    },
    "runtime_control_authority": {
      "const": "NONE"
    },
    "engineering_fence_authority": {
      "const": "DETERMINISTIC_EVALUATION_ONLY"
    },
    "canonical_evaluator": {
      "const": "scripts/evaluate_work_fence.py"
    },
    "canonical_selector_entrypoint": {
      "const": "scripts/select_work.py"
    },
    "component_stale_after_seconds": {
      "const": 1800
    },
    "legacy_v1_component_effective_expiry_rule": {
      "const": "AFTER_V4_MAIN_INTEGRATION_EFFECTIVE_EXPIRY_IS_MIN_STORED_EXPIRES_AT_AND_HEARTBEAT_PLUS_COMPONENT_STALE_AFTER_SECONDS"
    },
    "goal_execution_attempt_binding_rule": {
      "const": "WHEN_WORK_ID_IS_REGISTERED_IN_GOAL_EXECUTION_ATTEMPTS_RECORD_GOAL_ID_MUST_EQUAL_THE_UNIQUE_OWNER_GOAL_ID_RECORD_PLANNED_GOAL_REVISION_MUST_EQUAL_THE_ATTEMPT_PLANNED_GOAL_REVISION_AND_ATTEMPT_STATE_MUST_BE_ACTIVE;WHEN_WORK_ID_IS_NOT_REGISTERED_RECORD_GOAL_ID_AND_PLANNED_GOAL_REVISION_MUST_BOTH_BE_NULL"
    },
    "goal_execution_attempt_mismatch_result": {
      "const": "REPLAN_REQUIRED"
    },
    "goal_revision_fence_rule": {
      "const": "WHEN_GOAL_ID_IS_NON_NULL_PLANNED_GOAL_REVISION_MUST_EQUAL_CANONICAL_GOAL_REVISION"
    },
    "goal_revision_mismatch_result": {
      "const": "REPLAN_REQUIRED"
    },
    "generation_fence_rule": {
      "const": "WORK_RECORD_CLAIM_GENERATION_MUST_EQUAL_LIVE_CLAIM_GENERATION_AND_LIVE_CLAIM_WORK_ID_MUST_EQUAL_WORK_RECORD_WORK_ID"
    },
    "generation_mismatch_result": {
      "const": "STALE_GENERATION"
    },
    "control_signal_states": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NONE",
          "YIELD_OR_REPLAN_REQUESTED",
          "REASSIGNMENT_REQUESTED"
        ]
      }
    },
    "control_signal_rule": {
      "const": "NON_NONE_SIGNAL_APPLIES_ONLY_WHEN_TARGET_WORK_ID_EQUALS_EVALUATED_WORK_ID"
    },
    "external_effect_states": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NONE",
          "PENDING",
          "NO_RESULT",
          "TIMEOUT",
          "UNKNOWN",
          "SUCCESS",
          "FAILURE"
        ]
      }
    },
    "external_effect_unresolved_states": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PENDING",
          "NO_RESULT",
          "TIMEOUT",
          "UNKNOWN"
        ]
      }
    },
    "external_effect_unresolved_result": {
      "const": "EXTERNAL_EFFECT_RECONCILIATION_REQUIRED"
    },
    "evaluation_precedence": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXTERNAL_EFFECT_UNRESOLVED",
          "GOAL_EXECUTION_ATTEMPT_MISMATCH",
          "GOAL_REVISION_MISMATCH",
          "CONTROL_SIGNAL_ACTIVE",
          "CLAIM_GENERATION_MISMATCH",
          "CLAIM_OWNER_MISMATCH",
          "COMPONENT_LEASE_EXPIRED",
          "PASS"
        ]
      }
    },
    "protected_boundaries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SOURCE_WORKSPACE_MUTATION",
          "CONNECTED_APP_MUTATION",
          "CLAIM_RENEWAL",
          "WORK_SELECTION_DISPATCH",
          "PULL_REQUEST_VALIDATION",
          "MERGE_GROUP_VALIDATION"
        ]
      }
    },
    "thread_wakeup_dependency": {
      "const": "FORBIDDEN"
    },
    "takeover_rule": {
      "const": "COMPONENT_OWNERSHIP_TRANSFER_REQUIRES_PREDECESSOR_RELEASED_OR_EFFECTIVELY_EXPIRED_AND_GENERATION_PLUS_ONE_WITH_NEW_LEASE_ID;WORK_ID_MAY_REMAIN_SAME_FOR_DURABLE_WORK_RECOVERY"
    },
    "renewal_event_types": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PROTECTED_MUTATION_COMMITTED",
          "REQUIRED_CHECKPOINT_WRITTEN"
        ]
      }
    },
    "background_heartbeat_requirement": {
      "const": "NONE"
    },
    "scheduled_sweep_authority": {
      "const": "ADVISORY_ONLY"
    }
  }
}
