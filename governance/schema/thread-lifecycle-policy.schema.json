{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/governance/schema/thread-lifecycle-policy.schema.json",
  "title": "Life Thread Lifecycle Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","policy_id","runtime_control_authority","engineering_selection_precondition_authority","canonical_entrypoint","goal_policy_path","goal_registry_path","downstream_work_selection_policy_path","downstream_selector_path","boundary_states","interruption_rule","parent_return_rule","active_goal_rule","parallel_delegation_rule","downstream_authority_rule","terminal_cleanup_rule","terminal_handoff_rule","terminal_handoff_states","candidate_discovery_rule","candidate_effect","automatic_execution_rule","continue_rule","default_recommendation","options_rule","missing_evidence_rule"],
  "properties": {
    "schema_version":{"const":1},
    "policy_id":{"const":"life-thread-lifecycle-v1"},
    "runtime_control_authority":{"const":"NONE"},
    "engineering_selection_precondition_authority":{"const":"DETERMINISTIC_EVALUATION_ONLY"},
    "canonical_entrypoint":{"const":"scripts/evaluate_thread_lifecycle.py"},
    "goal_policy_path":{"const":"governance/goal-policy.json"},
    "goal_registry_path":{"const":"governance/goal-registry.json"},
    "downstream_work_selection_policy_path":{"const":"governance/work-selection-policy.json"},
    "downstream_selector_path":{"const":"scripts/select_work.py"},
    "boundary_states":{"const":["RESUME_INTERRUPTED_OPERATION","CONTINUE_ACTIVE_GOAL","RETURN_TO_PARENT_GOAL","DELEGATE_TO_WORK_SELECTION","TERMINAL_CLEANUP_REQUIRED","TERMINAL_HANDOFF"]},
    "interruption_rule":{"const":"UNRESOLVED_INTERRUPTED_OPERATION_RETURNS_RESUME_INTERRUPTED_OPERATION_BEFORE_GOAL_EVALUATION"},
    "parent_return_rule":{"const":"TERMINAL_ACTIVE_CHILD_WITH_NONTERMINAL_PARENT_RETURNS_PARENT_AS_EFFECTIVE_GOAL"},
    "active_goal_rule":{"const":"NONTERMINAL_EFFECTIVE_GOAL_COMPONENT_AVAILABLE_OR_OWNED_BY_REQUESTER_RETURNS_CONTINUE_ACTIVE_GOAL"},
    "parallel_delegation_rule":{"const":"NONTERMINAL_EFFECTIVE_GOAL_COMPONENT_ACTIVE_UNEXPIRED_FOR_OTHER_WORK_ID_RETURNS_DELEGATE_TO_WORK_SELECTION"},
    "downstream_authority_rule":{"const":"DOWNSTREAM_WORK_SELECTION_RESULT_HAS_ZERO_EXECUTION_EFFECT_UNLESS_BOUNDARY_STATE_IS_DELEGATE_TO_WORK_SELECTION"},
    "terminal_cleanup_rule":{"const":"TERMINAL_ROOT_WITH_ACTIVE_UNEXPIRED_ROOT_COMPONENT_CLAIM_RETURNS_TERMINAL_CLEANUP_REQUIRED"},
    "terminal_handoff_rule":{"const":"TERMINAL_ROOT_WITH_NO_ACTIVE_UNEXPIRED_ROOT_COMPONENT_CLAIM_RETURNS_TERMINAL_HANDOFF"},
    "terminal_handoff_states":{"const":["SAFE_TO_CLOSE_NO_CANDIDATE","SAFE_TO_CLOSE_WITH_CANDIDATE"]},
    "candidate_discovery_rule":{"const":"TERMINAL_HANDOFF_DISCOVERS_FIRST_DISPATCHABLE_UNCLAIMED_ADMITTED_ITEM_BY_EXISTING_TIE_BREAK_WITHOUT_ACQUIRING_A_CLAIM"},
    "candidate_effect":{"const":"ADVISORY_ONLY_ZERO_CLAIM_ACQUISITION_ZERO_EXECUTION"},
    "automatic_execution_rule":{"const":"FORBID_AUTOMATIC_EXECUTION_AFTER_TERMINAL_ROOT"},
    "continue_rule":{"const":"CONTINUE_CANDIDATE_ONLY_AFTER_EXACT_VINCE_CONTINUE_DIRECTIVE_OR_VERSIONED_AUTHORIZED_ROOT_TRANSITION"},
    "default_recommendation":{"const":"CLOSE_THREAD"},
    "options_rule":{"const":"SAFE_TO_CLOSE_NO_CANDIDATE_OPTIONS_EQUALS:CLOSE_THREAD;SAFE_TO_CLOSE_WITH_CANDIDATE_OPTIONS_EQUALS:CLOSE_THREAD,CONTINUE_WITH_CANDIDATE"},
    "missing_evidence_rule":{"const":"MISSING_INVALID_STALE_OR_UNVERIFIED_BOUNDARY_EVIDENCE_CANNOT_RETURN_TERMINAL_HANDOFF_OR_DELEGATE_TO_WORK_SELECTION"}
  }
}
