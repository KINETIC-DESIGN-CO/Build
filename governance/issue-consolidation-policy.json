{
  "schema_version": 1,
  "policy_id": "life-issue-consolidation-v1",
  "runtime_control_authority": "NONE",
  "engineering_consolidation_authority": "DETERMINISTIC_EVALUATION_ONLY",
  "unit_of_consolidation": "ATOMIC_REQUIREMENT_NOT_RAW_ISSUE",
  "source_issue_rule": "ONE_GITHUB_ISSUE_MAY_CONTAIN_ONE_OR_MORE_ATOMIC_REQUIREMENTS_WITH_DISTINCT_CANONICAL_WORK_IDENTITIES_AND_DEPENDENCIES",
  "candidate_discovery": {
    "authority": "ZERO",
    "permitted_sources": [
      "EXACT_ISSUE_CROSS_REFERENCE",
      "SEMANTIC_OR_VECTOR_RETRIEVAL",
      "MODEL_OR_HUMAN_REVIEW",
      "MACHINE_IDENTITY_COLLISION"
    ],
    "effect": "NOMINATE_CANDIDATE_PAIR_ONLY"
  },
  "terminal_relationships": [
    "DUPLICATE",
    "COMBINE_REQUIRED",
    "DEPENDENCY",
    "INDEPENDENT"
  ],
  "classification_states": [
    "UNRESOLVED",
    "CLASSIFIED"
  ],
  "relationship_derivation": {
    "duplicate_rule": "DUPLICATE_IFF_CANONICAL_REQUIREMENT_ID_EQUAL_AND_CANONICAL_WORK_IDENTITY_ID_EQUAL",
    "combine_rule": "COMBINE_REQUIRED_IFF_CANONICAL_REQUIREMENT_ID_DIFFERENT_AND_CANONICAL_WORK_IDENTITY_ID_EQUAL",
    "dependency_rule": "DEPENDENCY_IFF_CANONICAL_WORK_IDENTITY_ID_DIFFERENT_AND_EXACT_DEPENDENCY_EDGE_EXISTS_IN_EITHER_DIRECTION",
    "independent_rule": "INDEPENDENT_IFF_CANONICAL_WORK_IDENTITY_ID_DIFFERENT_AND_NO_DEPENDENCY_EDGE_EXISTS_IN_EITHER_DIRECTION_AND_EXACT_INDEPENDENCE_ASSERTION_EXISTS_FOR_THE_PAIR",
    "unresolved_rule": "UNRESOLVED_IFF_NONE_OF_DUPLICATE_COMBINE_DEPENDENCY_INDEPENDENT_RULES_PASS",
    "ambiguity_rule": "MORE_THAN_ONE_TERMINAL_RELATIONSHIP_PREDICATE_PASSING_IS_SCHEMA_OR_INVARIANT_VIOLATION"
  },
  "dispatch_rules": [
    "UNRESOLVED_CANDIDATE_PAIR_BLOCKS_INDEPENDENT_DISPATCH_FOR_EVERY_REQUIREMENT_IN_THAT_PAIR",
    "DUPLICATE_SOURCE_REQUIREMENTS_MAP_TO_EXACTLY_ONE_CANONICAL_REQUIREMENT_ID_AND_ONE_CANONICAL_WORK_IDENTITY_ID",
    "COMBINE_REQUIRED_REQUIREMENTS_MAP_TO_ONE_CANONICAL_WORK_IDENTITY_ID_AND_DISTINCT_CANONICAL_REQUIREMENT_IDS",
    "DEPENDENCY_REQUIREMENTS_USE_DISTINCT_CANONICAL_WORK_IDENTITY_IDS_AND_EXACT_DIRECTED_DEPENDENCY_EDGES",
    "INDEPENDENT_REQUIREMENTS_USE_DISTINCT_CANONICAL_WORK_IDENTITY_IDS_AND_REQUIRE_AN_EXACT_PAIR_ASSERTION",
    "NO_TWO_NONTERMINAL_DISPATCHABLE_WORK_ITEMS_MAY_SHARE_ONE_CANONICAL_WORK_IDENTITY_ID",
    "DUPLICATE_CLOSURE_REQUIRES_UNION_OF_SOURCE_ACCEPTANCE_CONDITION_IDS_TO_EQUAL_CANONICAL_ACCEPTANCE_CONDITION_IDS_BEFORE_CLOSE_READBACK",
    "GITHUB_DUPLICATE_SUB_ISSUE_AND_DEPENDENCY_METADATA_HAS_ZERO_ENGINEERING_SELECTION_AUTHORITY"
  ],
  "issue_eligibility_states": [
    "ACTIVE",
    "COMPLETE",
    "REMOVED",
    "EXCLUDED_INVALID_INTAKE"
  ],
  "dependency_rules": [
    "DEPENDENCY_GRAPH_MUST_BE_ACYCLIC",
    "SELF_DEPENDENCY_FORBIDDEN",
    "DEPENDENCY_WITHIN_ONE_CANONICAL_WORK_IDENTITY_FORBIDDEN_AND_MUST_BE_DECOMPOSED_BY_THE_PARENT_GOAL_MECHANISM"
  ],
  "integration": {
    "registry_path": "governance/issue-consolidation-registry.json",
    "schema_path": "governance/schema/issue-consolidation-registry.schema.json",
    "validator_path": "scripts/validate_issue_consolidation.py",
    "selector_activation_state": "SOURCE_ONLY_NOT_YET_CONSUMED_BY_WORK_SELECTION",
    "selector_activation_requires": [
      "BOOTSTRAP_REQUIRED_READ_OF_THIS_POLICY_AND_REGISTRY",
      "WORK_SELECTION_CONSUMES_CLASSIFIED_CANONICAL_WORK_IDENTITIES",
      "PARENT_GOAL_BINDING_READ_BACK_WHEN_REFERENCED",
      "FALSIFICATION_TESTS_PASS",
      "PROTECTED_MERGE_AND_MAIN_READBACK"
    ]
  }
}
