{
  "schema_version": 1,
  "policy_id": "life-live-worker-audit-repair-first-v1",
  "runtime_control_authority": "NONE",
  "assistant_procedure_authority": "BOOTSTRAP_REQUIRED_GOVERNANCE",
  "mode": "IN_RUN_EVENT_BOUNDARY_DRIVEN",
  "loop": ["AUDIT", "CLASSIFY", "FIX_OR_REPLAN", "VERIFY", "RESUME_PARENT_GOAL"],
  "trigger_ids": [
    "BEFORE_SELECTED_WORK_START",
    "BEFORE_PROTECTED_BOUNDARY",
    "AFTER_NEW_RESEARCH_BATCH",
    "AFTER_NEW_VERIFIED_EVIDENCE",
    "AFTER_REQUIRED_CHECK_TERMINAL",
    "AFTER_AUTHORITATIVE_READBACK_TERMINAL",
    "LIVE_MAIN_SHA_CHANGED",
    "TRACKED_PR_HEAD_OR_STATE_CHANGED",
    "GOAL_REVISION_OR_CONTROL_SIGNAL_CHANGED",
    "REQUIRED_CLAIM_STATE_GENERATION_OR_EXPIRY_CHANGED",
    "OPEN_BLOCKER_SET_CHANGED",
    "BEFORE_TERMINAL_COMPLETION",
    "BEFORE_FINAL_REQUIRED_CLAIM_RELEASE"
  ],
  "audit_dimensions": [
    "GOAL_ALIGNMENT",
    "OWNERSHIP_AND_FENCE",
    "DEPENDENCY_AND_INVARIANT_COVERAGE",
    "REGRESSION_STATE",
    "RESEARCH_EVIDENCE_HORIZON",
    "NEW_SYSTEM_EVIDENCE",
    "DURABLE_LESSON_OR_DEFECT_ROUTING"
  ],
  "dimension_states": ["PASS", "ISSUE", "NOT_RUN"],
  "audit_result_states": [
    "NO_COURSE_CHANGE_EVIDENCE",
    "RESEARCH_EXPANSION_REQUIRED",
    "REPLAN_CANDIDATE",
    "DEFECT_CANDIDATE",
    "VERIFICATION_REQUIRED",
    "EFFECT_RECONCILIATION_REQUIRED",
    "BLOCKED_RESOURCE",
    "BLOCKED_AUTHORIZATION",
    "BLOCKED_COST",
    "BLOCKED_PLATFORM",
    "NOT_RUN"
  ],
  "finding_states": ["NONE", "CANDIDATE", "VERIFIED_REPAIR", "RESEARCH_DESIGN_CHANGE", "VERIFICATION_GAP", "UNRESOLVED_EXTERNAL_EFFECT"],
  "verified_repair_evidence_classes": [
    "REQUIRED_CHECK_FAILURE",
    "SCHEMA_OR_INVARIANT_VIOLATION",
    "AUTHORITATIVE_LIVE_MISMATCH",
    "VERSIONED_FALSIFICATION_FAILURE",
    "VERIFIED_PLATFORM_INCOMPATIBILITY"
  ],
  "repair_lifecycle_states": ["NONE", "REPAIR_REQUIRED"],
  "execution_dispositions": [
    "CONTINUE_SELECTED_WORK",
    "EXPAND_RESEARCH",
    "REPLAN_BEFORE_PROTECTED_MUTATION",
    "RECORD_DEFECT_CANDIDATE",
    "EXECUTE_VERIFIED_REPAIR_CHILD",
    "VERIFY_BEFORE_CONTINUE",
    "RECONCILE_EFFECT_BEFORE_CONTINUE",
    "BLOCKED_RESOURCE",
    "BLOCKED_AUTHORIZATION",
    "BLOCKED_COST",
    "BLOCKED_PLATFORM",
    "NOT_RUN"
  ],
  "blocker_states": {
    "resource_state": ["AVAILABLE", "BLOCKED"],
    "authorization_state": ["AUTHORIZED", "BLOCKED"],
    "cost_state": ["NO_NEW_COMMITMENT", "AUTHORIZED_COMMITMENT", "BLOCKED"],
    "platform_state": ["AVAILABLE", "BLOCKED"]
  },
  "candidate_rule": "MODEL_REVIEW_PROSE_RESEARCH_OR_UNVERIFIED_FINDING_CAN_CREATE_CANDIDATE_ONLY_AND_HAS_ZERO_REPAIR_SELECTION_MUTATION_COMPLETION_VERIFICATION_RELEASE_OR_EFFECT_AUTHORITY",
  "verified_repair_rule": "VERIFIED_REPAIR_REQUIRES_EXACTLY_ONE_VERIFIED_REPAIR_EVIDENCE_CLASS_AND_RETURNS_REPAIR_REQUIRED;WITH_ZERO_EXACT_BLOCKERS_EXECUTION_DISPOSITION_IS_EXECUTE_VERIFIED_REPAIR_CHILD",
  "repair_identity_rule": "REPAIR_IDENTITY_IS_SHA256_OF_ROOT_GOAL_ID_EVIDENCE_CLASS_DETECTOR_OR_INVARIANT_ID_SUBJECT_ID_AND_COMPONENT_ID_WITH_NUL_SEPARATORS",
  "queue_rule": "QUEUED_ONLY_IS_NOT_A_HANDLED_VERIFIED_REPAIR_STATE;ONLY_AN_EXACT_BLOCKER_MAY_DEFER_AN_AFFECTED_OPERATION",
  "selection_binding_rule": "LIVE_AUDIT_EVALUATION_PRECEDES_NORMAL_WORK_SELECTION_AT_EACH_TRIGGER;REPAIR_REQUIRED_WITH_ZERO_EXACT_BLOCKERS_PRECEDES_ORDINARY_PLANNED_OR_ADMITTED_FEATURE_WORK;UNRESOLVED_EXTERNAL_EFFECT_RECONCILIATION_PRECEDES_REPAIR_EXECUTION",
  "resource_scope_rule": "BLOCKED_RESOURCE_BLOCKS_ONLY_OPERATIONS_WHOSE_EXACT_REQUIRED_RESOURCE_SET_INTERSECTS_THE_ACTIVE_UNEXPIRED_BLOCKING_CLAIM;DISJOINT_OPERATIONS_REMAIN_EXECUTABLE",
  "parent_goal_rule": "EXECUTE_VERIFIED_REPAIR_CHILD_USES_GOAL_RELATION_DEFECT_REPAIR_UNDER_THE_CURRENT_SEMANTIC_ROOT_AND_RETURNS_TO_THE_PARENT_AFTER_VERIFIED_FIXED",
  "research_binding_rule": "RESEARCH_EVIDENCE_HORIZON_DIMENSION_USES_GOVERNANCE_RESEARCH_POLICY_AND_ANY_APPLICABLE_NOT_RUN_LANE_RETURNS_RESEARCH_EXPANSION_REQUIRED_OR_NOT_RUN_BEFORE_PROTECTED_MUTATION",
  "snapshot_invalidation_rule": "LIVE_MAIN_SHA_CHANGED_OR_TRACKED_PR_HEAD_OR_STATE_CHANGED_INVALIDATES_SNAPSHOT_BOUND_VERIFICATION_AND_RETURNS_VERIFICATION_REQUIRED_UNTIL_RETESTED",
  "verification_rule": "VERIFIED_FIXED_REQUIRES_ORIGINAL_DETECTOR_OR_INVARIANT_RERUN_REQUIRED_TESTS_PROTECTED_INTEGRATION_WHEN_SOURCE_CHANGED_AND_AUTHORITATIVE_READBACK_FOR_CONNECTED_SYSTEM_MUTATIONS",
  "effect_precedence_rule": "UNRESOLVED_EXTERNAL_EFFECT_RETURNS_EFFECT_RECONCILIATION_REQUIRED_AND_RECONCILE_EFFECT_BEFORE_CONTINUE_BEFORE_TAKEOVER_RETRY_REPLAN_OR_REPAIR_EFFECT_EXECUTION",
  "non_authority_rule": "AUDIT_RECORD_MODEL_REVIEW_RESEARCH_ISSUE_PR_COMMENT_REVIEW_OR_LABEL_HAS_ZERO_AUTHORIZATION_ROUTING_PRIORITY_COMPLETION_VERIFICATION_RELEASE_MUTATION_OR_EFFECT_EXECUTION_AUTHORITY",
  "passive_terminal_states_forbidden": ["DOCUMENTED", "ACKNOWLEDGED", "DEFERRED", "WONTFIX", "LOW_PRIORITY", "QUEUED_ONLY"],
  "canonical_owner_bindings": {
    "repair_lifecycle": "governance/root-cause-repair-policy.json",
    "work_selection": "governance/work-selection-policy.json",
    "goal_identity": "governance/goal-policy.json",
    "source_coordination": "coordination/protocol.json",
    "research_depth": "governance/research-policy.json",
    "effect_execution": "scripts/evaluate_selected_operation_execution.py"
  }
}
