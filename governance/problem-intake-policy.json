{
  "schema_version": 1,
  "policy_id": "life-problem-intake-and-resolution-v1",
  "runtime_control_authority": "NONE",
  "assistant_procedure_authority": "ASSISTANT_PROCEDURE_ONLY",
  "intake": {
    "provider": "GITHUB_ISSUE",
    "repository": "KINETIC-DESIGN-CO/Build",
    "title_prefix": "[LIFE-INTAKE] ",
    "intake_authority": "ZERO",
    "input_classes": [
      "VINCE_DIRECTIVE",
      "VINCE_CORRECTION",
      "PROBLEM_CANDIDATE",
      "VERIFIED_DEFECT"
    ],
    "create_exemption_id": "ZERO_AUTHORITY_INTAKE_ISSUE_CREATE",
    "create_exemption_conditions": [
      "OPERATION_IS_CREATE_GITHUB_ISSUE",
      "TARGET_REPOSITORY_IS_KINETIC_DESIGN_CO_BUILD",
      "TITLE_STARTS_WITH_LITERAL_LIFE_INTAKE_PREFIX",
      "BODY_DECLARES_INTAKE_AUTHORITY_ZERO",
      "BODY_DECLARES_RUNTIME_CONTROL_AUTHORITY_NONE",
      "BODY_DECLARES_ONE_ENUMERATED_INPUT_CLASS",
      "OPERATION_DOES_NOT_EDIT_DELETE_CLOSE_LABEL_ASSIGN_MILESTONE_OR_COMMENT_ON_ANY_EXISTING_OBJECT"
    ],
    "create_exemption_effect": "CONTINUITY_SYNC_PREARM_NOT_REQUIRED_FOR_THIS_CREATE_ONLY_OPERATION",
    "problem_identity_rule": "PROBLEM_ID_IS_LOWERCASE_SHA256_OF_UTF8_PROBLEM_CLASS_LF_MECHANISM_ID_LF_DETECTOR_OR_INVARIANT_ID",
    "dedupe_rule": "BEFORE_CREATE_SEARCH_OPEN_LIFE_INTAKE_ISSUES_FOR_EXACT_PROBLEM_ID;IF_EXACTLY_ONE_EXISTS_REUSE_IT;IF_ZERO_EXIST_CREATE_ONE;IF_MORE_THAN_ONE_EXIST_CLASSIFY_SCHEMA_OR_INVARIANT_VIOLATION",
    "projection_rule": "INTAKE_ISSUE_HAS_ZERO_AUTHORIZATION_ROUTING_PRIORITY_STATE_TRANSITION_COMPLETION_VERIFICATION_ESCALATION_RELEASE_MUTATION_OR_EFFECT_EXECUTION_AUTHORITY_UNTIL_A_BOOTSTRAP_REQUIRED_PROCEDURE_CONSUMES_IT",
    "edit_rule": "ANY_LATER_EDIT_CLOSE_LABEL_ASSIGN_MILESTONE_OR_COMMENT_OPERATION_USES_NORMAL_CONTINUITY_AND_RESOURCE_RULES"
  },
  "problem_evaluation": {
    "trigger": "AFTER_ANY_OBSERVED_SYSTEM_ERROR_BLOCKER_FRICTION_OR_STALE_MECHANISM",
    "required_steps": [
      "ENSURE_DURABLE_INTAKE_EXISTS",
      "IDENTIFY_EXACT_MECHANISM_ID",
      "IDENTIFY_EXACT_PROTECTED_INVARIANT_IDS",
      "READ_CURRENT_IMPLEMENTATION_AND_AUTHORIZED_LIVE_STATE",
      "SEARCH_CURRENT_PLATFORM_AND_ENGINEERING_EVIDENCE_FOR_SUCCESSOR_OR_REPAIR",
      "CLASSIFY_EXACT_DISPOSITION",
      "EXECUTE_REPAIR_OR_REMOVAL_WHEN_EXACT_REQUIRED_CLAIMS_AUTHORIZATION_AND_COST_STATE_PASS",
      "READ_BACK_AND_VERIFY_RESULT"
    ],
    "states": [
      "PROBLEM_CANDIDATE",
      "VERIFIED_DEFECT",
      "REPAIR_REQUIRED",
      "REMOVE_REQUIRED",
      "KEEP_REQUIRED",
      "BLOCKED_RESOURCE",
      "BLOCKED_AUTHORIZATION",
      "BLOCKED_COST",
      "BLOCKED_PLATFORM",
      "BLOCKED_EVIDENCE",
      "VERIFYING",
      "VERIFIED_FIXED",
      "VERIFIED_REMOVED",
      "REJECTED_NOT_PROBLEM"
    ],
    "verified_defect_evidence_classes": [
      "REQUIRED_CHECK_FAILURE",
      "SCHEMA_OR_INVARIANT_VIOLATION",
      "AUTHORITATIVE_LIVE_MISMATCH",
      "VERSIONED_FALSIFICATION_FAILURE",
      "VERIFIED_PLATFORM_INCOMPATIBILITY"
    ],
    "remove_rule": "REMOVE_REQUIRED_IFF_EVERY_PROTECTED_INVARIANT_ID_OF_THE_BLOCKING_MECHANISM_IS_COVERED_BY_A_CURRENT_VERIFIED_SUCCESSOR_MECHANISM_ID",
    "keep_rule": "KEEP_REQUIRED_IFF_A_CURRENT_MACHINE_READABLE_RULE_EXPLICITLY_REQUIRES_THE_EXACT_MECHANISM_ID_AND_NO_CURRENT_VERIFIED_SUCCESSOR_RECORD_COVERS_EVERY_PROTECTED_INVARIANT_ID",
    "repair_rule": "REPAIR_REQUIRED_IFF_ONE_VERIFIED_DEFECT_EVIDENCE_CLASS_IS_PRESENT_AND_REMOVE_RULE_IS_FALSE",
    "blocked_evidence_rule": "BLOCKED_EVIDENCE_IFF_REMOVE_RULE_KEEP_RULE_AND_REPAIR_RULE_ALL_LACK_THEIR_REQUIRED_MACHINE_READABLE_OR_CURRENT_VERIFIED_EVIDENCE",
    "repair_item_rule": "EACH_PROBLEM_ID_WITH_STATE_REPAIR_REQUIRED_OR_REMOVE_REQUIRED_MAPS_TO_EXACTLY_ONE_NONTERMINAL_REPAIR_WORK_ITEM_ID;A_SECOND_NONTERMINAL_REPAIR_WORK_ITEM_FOR_THE_SAME_PROBLEM_ID_IS_SCHEMA_OR_INVARIANT_VIOLATION",
    "bootstrap_effect": {
      "execute_before_work_selection_states": [
        "REPAIR_REQUIRED",
        "REMOVE_REQUIRED"
      ],
      "execute_before_work_selection_effect": "EXECUTE_OR_ENTER_ONE_EXACT_BLOCKED_STATE_BEFORE_EVALUATE_WORK_SELECTION",
      "continue_to_work_selection_states": [
        "KEEP_REQUIRED",
        "VERIFIED_FIXED",
        "VERIFIED_REMOVED",
        "REJECTED_NOT_PROBLEM"
      ],
      "continue_to_work_selection_effect": "CONTINUE_TO_EVALUATE_WORK_SELECTION",
      "preserve_without_drop_states": [
        "PROBLEM_CANDIDATE",
        "VERIFIED_DEFECT",
        "BLOCKED_RESOURCE",
        "BLOCKED_AUTHORIZATION",
        "BLOCKED_COST",
        "BLOCKED_PLATFORM",
        "BLOCKED_EVIDENCE",
        "VERIFYING"
      ],
      "preserve_without_drop_effect": "PRESERVE_STATE_AND_DO_NOT_DROP_THE_PROBLEM"
    },
    "no_passive_outcome_rule": "ACKNOWLEDGED_DOCUMENTED_DEFERRED_WONTFIX_AND_LOW_PRIORITY_ARE_NOT_TERMINAL_STATES",
    "completion_rule": "VERIFIED_FIXED_OR_VERIFIED_REMOVED_REQUIRES_RERUN_OF_THE_ORIGINAL_EXACT_DETECTOR_OR_INVARIANT_PLUS_REQUIRED_TESTS_AND_AUTHORIZED_SYSTEM_READBACK_FOR_ANY_CONNECTED_SYSTEM_MUTATION"
  },
  "current_continuity_split": {
    "canonical_projection_resource": "continuity:sync",
    "canonical_projection_rule": "KEEP_SINGLE_WRITER_FOR_CANONICAL_CONTINUITY_PROJECTION_AND_MAIN_INTEGRATION",
    "intake_rule": "DO_NOT_REQUIRE_CANONICAL_PROJECTION_RESOURCE_FOR_ZERO_AUTHORITY_INTAKE_ISSUE_CREATE_WHEN_ALL_CREATE_EXEMPTION_CONDITIONS_PASS",
    "existing_claim_migration": "NO_EXISTING_ACTIVE_CONTINUITY_SYNC_CLAIM_IS_RELEASED_TAKEN_OVER_OR_MUTATED_BY_THIS_POLICY"
  }
}
