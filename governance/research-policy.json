{
  "schema_version": 1,
  "policy_id": "life-research-source-neighborhood-v1",
  "runtime_control_authority": "NONE",
  "assistant_procedure_authority": "BOOTSTRAP_REQUIRED_GOVERNANCE",
  "research_authority": "EVIDENCE_ONLY",
  "trigger": "ARCHITECTURE_OR_IMPLEMENTATION_DECISION_USES_EXTERNAL_PLATFORM_MECHANISM_RESEARCH_OR_CURRENT_ENGINEERING_EVIDENCE",
  "required_lane_ids": [
    "WHOLE_SOURCE_CONTEXT",
    "SAME_PUBLISHER_NEIGHBORHOOD",
    "INDEPENDENT_PARALLEL_EVIDENCE",
    "ALTERNATIVE_MECHANISM",
    "FAILURE_OR_PRACTITIONER_EVIDENCE",
    "DISCONFIRMATION_SEARCH",
    "LIFE_COMPARISON"
  ],
  "lane_attempt_states": [
    "ATTEMPTED",
    "NOT_ATTEMPTED"
  ],
  "lane_result_states": [
    "EVIDENCE_FOUND",
    "NOT_RUN",
    "NOT_APPLICABLE"
  ],
  "same_publisher_required_categories": [
    "LIFECYCLE_OR_STATE_MODEL",
    "FAILURE_MODES",
    "TAKEOVER_PREEMPTION_OR_CANCELLATION",
    "STALE_RESULT_VERSIONING_OR_FENCING",
    "RECOVERY_OR_IDEMPOTENCY",
    "LIMITS_QUOTAS_OR_COST",
    "OPERATIONAL_CAVEATS"
  ],
  "closure_rule": "RESEARCH_MAY_CLOSE_ONLY_AFTER_EVERY_REQUIRED_LANE_HAS_ATTEMPT_STATE_ATTEMPTED;A_RESULT_STATE_NOT_RUN_MUST_REMAIN_VISIBLE_AND_HAS_ZERO_SUPPORTING_EVIDENCE_EFFECT",
  "narrow_corroboration_rule": "NARROW_CORROBORATION_FALSE_CLOSURE:A_MATCHING_PASSAGE_OR_SINGLE_SUPPORTING_SOURCE_CANNOT_COMPLETE_RESEARCH_BY_ITSELF",
  "whole_source_rule": "WHOLE_SOURCE_CONTEXT_READS_BEYOND_THE_MATCHING_PASSAGE_AND_INSPECTS_THE_SOURCE_SUBSYSTEM_ROOT_OR_INDEX_CONTEXT",
  "parallel_evidence_rule": "INDEPENDENT_PARALLEL_EVIDENCE_SEARCHES_CURRENT_INDEPENDENT_SOURCES_FOR_THE_SAME_PROBLEM_CLASS",
  "alternative_rule": "ALTERNATIVE_MECHANISM_SEARCHES_AT_LEAST_ONE_CURRENT_COMPETING_MECHANISM_FOR_THE_SAME_PROBLEM_CLASS",
  "failure_rule": "FAILURE_OR_PRACTITIONER_EVIDENCE_SEARCHES_IMPLEMENTATION_FAILURES_LIMITS_WORKAROUNDS_OR_USER_EXPERIENCE_FOR_THE_SAME_PROBLEM_CLASS",
  "disconfirmation_rule": "DISCONFIRMATION_SEARCH_EXPLICITLY_SEARCHES_FOR_EVIDENCE_THAT_WOULD_REJECT_OR_CHANGE_THE_CURRENT_DESIGN",
  "comparison_dispositions": [
    "KEEP",
    "REPLACE",
    "MODIFY",
    "COMBINE",
    "REMOVE"
  ],
  "life_comparison_rule": "LIFE_COMPARISON_RECORDS_ONE_CURRENT_DISPOSITION_FOR_EACH_CANDIDATE_AND_COMPARES_IMPLEMENT_NOW_WITH_IMPLEMENT_LATER_MIGRATION_DUPLICATION_REMOVAL_OR_REBUILD_EFFECTS",
  "design_change_rule": "IF_BROADER_EVIDENCE_CHANGES_AN_ASSUMPTION_GATE_STATE_MODEL_TIMING_RULE_FAILURE_PATH_OR_IMPLEMENTATION_CHOICE_THE_CURRENT_WORK_RETURNS_RESEARCH_DESIGN_CHANGE_TO_THE_LIVE_AUDIT_EVALUATOR_BEFORE_THE_NEXT_PROTECTED_MUTATION",
  "non_authority_rule": "RESEARCH_RESULT_ISSUE_TEXT_MODEL_JUDGMENT_OR_CITATION_CANNOT_CREATE_AUTHORIZATION_ROUTING_PRIORITY_COMPLETION_VERIFICATION_RELEASE_MUTATION_OR_EFFECT_EXECUTION_PASS",
  "persistence_rule": "WHEN_RESEARCH_CHANGES_A_PERSISTENT_LIFE_REQUIREMENT_OR_IMPLEMENTATION_DECISION_PRESERVE_SOURCE_REFERENCES_LANE_STATES_SELECTED_DISPOSITION_AND_CHANGED_ASSUMPTION_IDS_IN_THE_CANONICAL_OWNER_OR_ITS_DURABLE_EVIDENCE_RECORD"
}
