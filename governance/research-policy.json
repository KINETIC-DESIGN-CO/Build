{
  "schema_version": 1,
  "policy_id": "life-research-evidence-horizon-v1",
  "runtime_control_authority": "NONE",
  "assistant_procedure_authority": "BOOTSTRAP_REQUIRED_GOVERNANCE",
  "research_authority": "EVIDENCE_ONLY",
  "trigger": "ARCHITECTURE_OR_IMPLEMENTATION_DECISION_USES_EXTERNAL_PLATFORM_MECHANISM_RESEARCH_OR_CURRENT_ENGINEERING_EVIDENCE",
  "required_lane_ids": [
    "WHOLE_SOURCE_CONTEXT",
    "SOURCE_SYSTEM_CONTEXT",
    "SAME_SOURCE_PARALLEL",
    "INDEPENDENT_PARALLEL_EVIDENCE",
    "COMPETING_MECHANISMS",
    "FAILURE_AND_COUNTEREXAMPLE_EVIDENCE",
    "DISCONFIRMATION_SEARCH",
    "LIFE_REEVALUATION"
  ],
  "lane_result_states": [
    "EVIDENCE_FOUND",
    "NO_EVIDENCE_FOUND",
    "NOT_APPLICABLE",
    "NOT_RUN"
  ],
  "source_system_required_categories": [
    "LIFECYCLE_OR_STATE_MODEL",
    "FAILURE_MODES",
    "RENEWAL_TAKEOVER_PREEMPTION_OR_CANCELLATION",
    "STALE_RESULT_VERSIONING_OR_FENCING",
    "RECOVERY_OR_IDEMPOTENCY",
    "LIMITS_QUOTAS_OR_COST",
    "OPERATIONAL_CAVEATS"
  ],
  "closure_rule": "RESEARCH_COMPLETE_REQUIRES_EVERY_APPLICABLE_REQUIRED_LANE_STATE_NE_NOT_RUN_AND_LIFE_REEVALUATION_STATE_EVIDENCE_FOUND",
  "narrow_corroboration_rule": "NARROW_CORROBORATION_FALSE_CLOSURE:A_MATCHING_PASSAGE_OR_SINGLE_SUPPORTING_SOURCE_CANNOT_COMPLETE_RESEARCH",
  "whole_source_rule": "WHOLE_SOURCE_CONTEXT_READS_BEYOND_THE_MATCHING_PASSAGE_AND_INSPECTS_THE_COMPLETE_SOURCE_CONTEXT",
  "source_system_rule": "SOURCE_SYSTEM_CONTEXT_SEARCHES_THE_SAME_PUBLISHER_OR_SYSTEM_FOR_EVERY_SOURCE_SYSTEM_REQUIRED_CATEGORY",
  "same_source_parallel_rule": "SAME_SOURCE_PARALLEL_SEARCHES_ADDITIONAL_CURRENT_ARTICLES_DOCUMENTS_OR_SECTIONS_FROM_THE_SAME_SOURCE_FAMILY_FOR_THE_SAME_SYSTEM_OR_PROBLEM_CLASS",
  "independent_parallel_rule": "INDEPENDENT_PARALLEL_EVIDENCE_STATE_EVIDENCE_FOUND_REQUIRES_AT_LEAST_TWO_DISTINCT_CURRENT_SOURCE_FAMILY_IDS",
  "competing_mechanism_rule": "COMPETING_MECHANISMS_STATE_EVIDENCE_FOUND_REQUIRES_AT_LEAST_ONE_CURRENT_ALTERNATIVE_ID",
  "failure_rule": "FAILURE_AND_COUNTEREXAMPLE_EVIDENCE_SEARCHES_CURRENT_FAILURE_INCIDENT_LIMITATION_OR_EMPIRICAL_COUNTEREXAMPLE_EVIDENCE;NO_EVIDENCE_FOUND_REQUIRES_AT_LEAST_ONE_ATTEMPTED_SEARCH_REF",
  "disconfirmation_rule": "DISCONFIRMATION_SEARCH_ACTIVELY_SEARCHES_FOR_EVIDENCE_THAT_THE_CURRENT_RECOMMENDATION_IS_INCOMPLETE_UNSAFE_UNNECESSARILY_COMPLEX_OBSOLETE_OR_INFERIOR_ON_AN_ENUMERATED_REQUIREMENT;NO_EVIDENCE_FOUND_REQUIRES_AT_LEAST_ONE_ATTEMPTED_SEARCH_REF",
  "comparison_dispositions": [
    "KEEP",
    "REPLACE",
    "MODIFY",
    "COMBINE",
    "REMOVE"
  ],
  "life_reevaluation_rule": "LIFE_REEVALUATION_REQUIRES_ONE_SELECTED_DISPOSITION_AND_AT_LEAST_ONE_AFFECTED_REQUIREMENT_OR_INVARIANT_ID_AND_COMPARES_IMPLEMENT_NOW_WITH_IMPLEMENT_LATER_MIGRATION_DUPLICATION_REMOVAL_OR_REBUILD_EFFECTS",
  "design_change_rule": "ANY_DESIGN_CHANGE_ID_REQUIRES_REPLAN_BEFORE_THE_NEXT_PROTECTED_MUTATION",
  "non_authority_rule": "RESEARCH_RESULT_ISSUE_TEXT_MODEL_JUDGMENT_OR_CITATION_CANNOT_CREATE_AUTHORIZATION_ROUTING_PRIORITY_COMPLETION_VERIFICATION_RELEASE_MUTATION_OR_EFFECT_EXECUTION_PASS",
  "persistence_rule": "PERSIST_SOURCE_REFERENCES_LANE_STATES_SELECTED_DISPOSITION_AFFECTED_REQUIREMENT_OR_INVARIANT_IDS_AND_DESIGN_CHANGE_IDS_WHEN_RESEARCH_CHANGES_A_PERSISTENT_LIFE_REQUIREMENT_OR_IMPLEMENTATION_DECISION"
}
