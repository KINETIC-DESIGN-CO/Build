{
  "schema_version": 1,
  "policy_id": "life-continuity-checkpoint-v1",
  "runtime_control_authority": "NONE",
  "checkpoint_authority": "EVIDENCE_ONLY",
  "checkpoint_directory": "continuity/checkpoints",
  "checkpoint_filename_pattern": "^CP-[0-9]{6}-[0-9a-f]{8}\\.json$",
  "checkpoint_template_path": "continuity/checkpoint-template.json",
  "checkpoint_schema_path": "continuity/checkpoint.schema.json",
  "directive_ledger_path": "continuity/directive-ledger.jsonl",
  "decision_rationale_path": "continuity/decision-rationale.jsonl",
  "storage_branch_rule": "WRITE_CHECKPOINT_TO_EXACT_IMPLEMENTATION_BRANCH_FOR_CHECKPOINT_WORK_ID",
  "discovery_precondition": "DERIVE_WORK_ID_AND_IMPLEMENTATION_BRANCH_FROM_FRESH_LIVE_COORDINATION_STATE_BEFORE_CHECKPOINT_DISCOVERY",
  "latest_checkpoint_rule": "ON_DERIVED_IMPLEMENTATION_BRANCH_FILTER_SCHEMA_VALID_CHECKPOINTS_TO_EXACT_WORK_ID_THEN_SELECT_MAX_CREATED_AT_THEN_CHECKPOINT_ID_LEXICOGRAPHIC",
  "missing_checkpoint_rule": "NO_SCHEMA_VALID_CHECKPOINT_FOR_DERIVED_WORK_ID_RETURNS_NONE_AND_DOES_NOT_BLOCK_BOOTSTRAP",
  "goal_snapshot_enforcement_utc": "2026-09-13T08:32:54Z",
  "goal_snapshot_rule": "CHECKPOINT_CREATED_AT_UTC_GTE_GOAL_SNAPSHOT_ENFORCEMENT_UTC_MUST_INCLUDE_GOAL_SNAPSHOT_WITH_ROOT_ACTIVE_AND_EXACT_ACTIVE_PATH_AS_HISTORICAL_OBSERVATION_ONLY",
  "trigger_mode": "ANY_TRUE",
  "trigger_ids": [
    "EXPLICIT_CHECKPOINT_REQUESTED",
    "MUTATION_RESULT_TERMINAL",
    "BOOTSTRAP_CONTINUITY_EVENT_OCCURRED",
    "CANONICAL_LIVE_MISMATCH_SET_CHANGED",
    "SELECTED_WORK_OR_RANK_CHANGED",
    "OPEN_BLOCKER_SET_CHANGED",
    "LIVE_MAIN_SHA_CHANGED",
    "TRACKED_PR_STATE_CHANGED",
    "MERGE_GROUP_TERMINAL",
    "POST_MERGE_VALIDATE_TERMINAL",
    "INTERRUPTED_OPERATION_UNRESOLVED",
    "BEFORE_FINAL_REQUIRED_CLAIM_RELEASE",
    "NON_CHECKPOINT_TOOL_RESULT_COUNT_GTE_LIMIT",
    "ELAPSED_SECONDS_GTE_LIMIT_WITH_NEW_EVIDENCE"
  ],
  "mutation_terminal_states": [
    "SUCCESS",
    "FAILURE",
    "NO_RESULT",
    "TIMEOUT",
    "UNKNOWN"
  ],
  "interruption_states": [
    "PENDING",
    "NO_RESULT",
    "TIMEOUT",
    "UNKNOWN"
  ],
  "merge_group_terminal_states": [
    "SUCCESS",
    "FAILURE",
    "CANCELLED"
  ],
  "post_merge_validate_terminal_states": [
    "SUCCESS",
    "FAILURE",
    "CANCELLED"
  ],
  "cadence": {
    "non_checkpoint_tool_result_limit": 12,
    "elapsed_seconds_limit": 1800,
    "elapsed_trigger_min_new_evidence_items": 1
  },
  "coalescing_rule": "ALL_TRUE_TRIGGER_IDS_OBSERVED_BEFORE_ONE_CHECKPOINT_WRITE_ARE_RECORDED_IN_ONE_CHECKPOINT",
  "recursion_rule": "CHECKPOINT_WRITE_DOES_NOT_TRIGGER_A_CHECKPOINT_SOLELY_BECAUSE_THE_CHECKPOINT_WRITE_OCCURRED",
  "final_claim_rule": "IF_A_WORK_ITEM_WOULD_RELEASE_ITS_LAST_REQUIRED_ACTIVE_CLAIM_CREATE_AND_READ_BACK_ONE_CHECKPOINT_BEFORE_THE_RELEASE",
  "evidence_classes": [
    "IMMUTABLE_REPOSITORY",
    "HISTORICAL_OBSERVATION",
    "LIVE_GITHUB",
    "LIVE_SUPABASE",
    "LIVE_VERCEL",
    "VINCE_DIRECTIVE",
    "VINCE_OBSERVATION",
    "RESEARCH_SOURCE",
    "INFERRED"
  ],
  "live_verify_required_classes": [
    "LIVE_GITHUB",
    "LIVE_SUPABASE",
    "LIVE_VERCEL"
  ],
  "resume_rule": "CHECKPOINT_RESUME_CANDIDATE_HAS_ZERO_WORK_SELECTION_OR_MUTATION_AUTHORITY_AND_MUST_BE_REEVALUATED_AFTER_BOOTSTRAP_LIVE_VERIFICATION_AND_DETERMINISTIC_SELECTION",
  "control_decision_kinds_forbidden_from_checkpoint_authority": [
    "AUTHORIZATION",
    "ROUTING",
    "PRIORITY",
    "STATE_TRANSITION",
    "COMPLETION",
    "VERIFICATION",
    "ESCALATION",
    "RELEASE",
    "MUTATION",
    "EFFECT_EXECUTION"
  ],
  "unknown_preservation_rule": "UNKNOWN_NOT_RUN_UNVERIFIED_AND_INFERRED_STATES_MUST_NOT_BE_RELABELED_VERIFIED_BY_CHECKPOINT_CREATION",
  "volatile_state_rule": "A_CHECKPOINT_MAY_RECORD_A_VOLATILE_FACT_ONLY_AS_AN_OBSERVATION_WITH_OBSERVED_AT_AND_LIVE_VERIFY_REQUIRED_TRUE",
  "directive_rule": "VINCE_QUOTES_AND_CONTEXT_ARE_PRESERVED_AS_PROVENANCE_BUT_HAVE_ZERO_RUNTIME_CONTROL_AUTHORITY",
  "research_rule": "RESEARCH_REFERENCES_RECORD_SOURCE_KIND_TITLE_URL_OBSERVED_DATE_AND_SUPPORTED_CLAIM_WHEN_RESEARCH_INFORMED_A_PERSISTENT_DIRECTIVE_OR_DECISION"
}
