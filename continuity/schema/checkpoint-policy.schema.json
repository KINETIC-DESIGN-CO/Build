{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/continuity/schema/checkpoint-policy.schema.json",
  "title": "Life Continuity Checkpoint Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "runtime_control_authority",
    "checkpoint_authority",
    "checkpoint_directory",
    "checkpoint_filename_pattern",
    "checkpoint_template_path",
    "checkpoint_schema_path",
    "directive_ledger_path",
    "decision_rationale_path",
    "trigger_mode",
    "trigger_ids",
    "mutation_terminal_states",
    "interruption_states",
    "merge_group_terminal_states",
    "post_merge_validate_terminal_states",
    "cadence",
    "coalescing_rule",
    "recursion_rule",
    "final_claim_rule",
    "evidence_classes",
    "live_verify_required_classes",
    "resume_rule",
    "control_decision_kinds_forbidden_from_checkpoint_authority",
    "unknown_preservation_rule",
    "volatile_state_rule",
    "directive_rule",
    "research_rule"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "life-continuity-checkpoint-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "checkpoint_authority": {"const": "EVIDENCE_ONLY"},
    "checkpoint_directory": {"const": "continuity/checkpoints"},
    "checkpoint_filename_pattern": {"type": "string", "minLength": 1},
    "checkpoint_template_path": {"const": "continuity/checkpoint-template.json"},
    "checkpoint_schema_path": {"const": "continuity/schema/checkpoint.schema.json"},
    "directive_ledger_path": {"const": "continuity/directive-ledger.jsonl"},
    "decision_rationale_path": {"const": "continuity/decision-rationale.jsonl"},
    "trigger_mode": {"const": "ANY_TRUE"},
    "trigger_ids": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"enum": ["EXPLICIT_CHECKPOINT_REQUESTED", "MUTATION_RESULT_TERMINAL", "BOOTSTRAP_CONTINUITY_EVENT_OCCURRED", "CANONICAL_LIVE_MISMATCH_SET_CHANGED", "SELECTED_WORK_OR_RANK_CHANGED", "OPEN_BLOCKER_SET_CHANGED", "LIVE_MAIN_SHA_CHANGED", "TRACKED_PR_STATE_CHANGED", "MERGE_GROUP_TERMINAL", "POST_MERGE_VALIDATE_TERMINAL", "INTERRUPTED_OPERATION_UNRESOLVED", "BEFORE_FINAL_REQUIRED_CLAIM_RELEASE", "NON_CHECKPOINT_TOOL_RESULT_COUNT_GTE_LIMIT", "ELAPSED_SECONDS_GTE_LIMIT_WITH_NEW_EVIDENCE"]}},
    "mutation_terminal_states": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["SUCCESS", "FAILURE", "NO_RESULT", "TIMEOUT", "UNKNOWN"]}},
    "interruption_states": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["PENDING", "NO_RESULT", "TIMEOUT", "UNKNOWN"]}},
    "merge_group_terminal_states": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["SUCCESS", "FAILURE", "CANCELLED"]}},
    "post_merge_validate_terminal_states": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["SUCCESS", "FAILURE", "CANCELLED"]}},
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_checkpoint_tool_result_limit", "elapsed_seconds_limit", "elapsed_trigger_min_new_evidence_items"],
      "properties": {
        "non_checkpoint_tool_result_limit": {"const": 12},
        "elapsed_seconds_limit": {"const": 1800},
        "elapsed_trigger_min_new_evidence_items": {"const": 1}
      }
    },
    "coalescing_rule": {"const": "ALL_TRUE_TRIGGER_IDS_OBSERVED_BEFORE_ONE_CHECKPOINT_WRITE_ARE_RECORDED_IN_ONE_CHECKPOINT"},
    "recursion_rule": {"const": "CHECKPOINT_WRITE_DOES_NOT_TRIGGER_A_CHECKPOINT_SOLELY_BECAUSE_THE_CHECKPOINT_WRITE_OCCURRED"},
    "final_claim_rule": {"const": "IF_A_WORK_ITEM_WOULD_RELEASE_ITS_LAST_REQUIRED_ACTIVE_CLAIM_CREATE_AND_READ_BACK_ONE_CHECKPOINT_BEFORE_THE_RELEASE"},
    "evidence_classes": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"enum": ["IMMUTABLE_REPOSITORY", "HISTORICAL_OBSERVATION", "LIVE_GITHUB", "LIVE_SUPABASE", "LIVE_VERCEL", "VINCE_DIRECTIVE", "VINCE_OBSERVATION", "RESEARCH_SOURCE", "INFERRED"]}},
    "live_verify_required_classes": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["LIVE_GITHUB", "LIVE_SUPABASE", "LIVE_VERCEL"]}},
    "resume_rule": {"type": "string", "minLength": 1},
    "control_decision_kinds_forbidden_from_checkpoint_authority": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["AUTHORIZATION", "ROUTING", "PRIORITY", "STATE_TRANSITION", "COMPLETION", "VERIFICATION", "ESCALATION", "RELEASE", "MUTATION", "EFFECT_EXECUTION"]}},
    "unknown_preservation_rule": {"type": "string", "minLength": 1},
    "volatile_state_rule": {"type": "string", "minLength": 1},
    "directive_rule": {"type": "string", "minLength": 1},
    "research_rule": {"type": "string", "minLength": 1}
  }
}
