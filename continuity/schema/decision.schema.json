{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinanonymous/Build/blob/main/continuity/schema/decision.schema.json",
  "title": "Life Continuity Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","state","disposition","statement","rationale","evidence","supersedes","recorded_at","runtime_control_authority"],
  "properties": {
    "id": {"type":"string","pattern":"^D-[0-9]{4}$"},
    "state": {"enum":["ACTIVE","RETIRED"]},
    "disposition": {"enum":["KEEP","REPLACE","MODIFY","COMBINE","REMOVE"]},
    "statement": {"type":"string","minLength":1},
    "rationale": {"type":"string","minLength":1},
    "evidence": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "supersedes": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^D-[0-9]{4}$"}},
    "recorded_at": {"type":"string","format":"date-time"},
    "runtime_control_authority": {"const":"NONE"}
  }
}
