{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/continuity/schema/current.schema.json",
  "title": "Life Continuity Current State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","manifest_revision","project_id","runtime_control_authority","updated_at","objective","phase","current_component","current_status","authorized_targets","current_work","active_decision_ids","retired_decision_ids","open_questions","blockers","last_observed","next_action"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_revision": {"type":"integer","minimum":1},
    "project_id": {"const":"life"},
    "runtime_control_authority": {"const":"NONE"},
    "updated_at": {"type":"string","format":"date-time"},
    "objective": {"type":"string","minLength":1},
    "phase": {"enum":["RESEARCH","DESIGN","IMPLEMENTATION","VERIFICATION","DEPLOYMENT","OPERATIONS"]},
    "current_component": {"type":"string","pattern":"^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "current_status": {"enum":["ACTIVE","BLOCKED","COMPLETE"]},
    "authorized_targets": {
      "type":"object","additionalProperties":false,"required":["github","supabase","vercel"],
      "properties": {
        "github": {"type":"object","additionalProperties":false,"required":["repository_id","full_name","visibility","default_branch"],"properties":{"repository_id":{"const":1366835183},"full_name":{"const":"KINETIC-DESIGN-CO/Build"},"visibility":{"const":"public"},"default_branch":{"const":"main"}}},
        "supabase": {"type":"object","additionalProperties":false,"required":["project_id","name","region"],"properties":{"project_id":{"const":"jnenguxodtgwbskhdsxt"},"name":{"const":"Life"},"region":{"const":"us-west-2"}}},
        "vercel": {"type":["object","null"]}
      }
    },
    "current_work": {"type":"object","additionalProperties":false,"required":["goal","completion_conditions"],"properties":{"goal":{"type":"string","minLength":1},"completion_conditions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "active_decision_ids": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^D-[0-9]{4}$"}},
    "retired_decision_ids": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^D-[0-9]{4}$"}},
    "open_questions": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","state","question","resolution_decision_id"],"properties":{"id":{"type":"string","pattern":"^Q-[0-9]{4}$"},"state":{"enum":["OPEN","RESOLVED"]},"question":{"type":"string","minLength":1},"resolution_decision_id":{"type":["string","null"],"pattern":"^D-[0-9]{4}$"}}}},
    "blockers": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","state","condition","clears_when"],"properties":{"id":{"type":"string","pattern":"^B-[0-9]{4}$"},"state":{"enum":["OPEN","RESOLVED"]},"condition":{"type":"string","minLength":1},"clears_when":{"type":"string","minLength":1}}}},
    "last_observed": {"type":"object","minProperties":1},
    "next_action": {"type":"object","additionalProperties":false,"required":["id","name","kind","target","description","authorization_effect"],"properties":{"id":{"type":"string","pattern":"^A-[0-9]{4}$"},"name":{"type":"string","minLength":1,"maxLength":160},"kind":{"enum":["RESEARCH","READ","DESIGN","IMPLEMENT","VERIFY","MUTATE","DEPLOY"]},"target":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"authorization_effect":{"const":"NONE"}}}
  }
}
