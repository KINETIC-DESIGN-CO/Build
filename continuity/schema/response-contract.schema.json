{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Response Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract_id","runtime_control_authority","default_mode","required_sections","state_terms","plain_english_rule","technical_only_exception","precision_rule","platform_feature_fields","copy_paste_rule","completion_rule","progression_rule","persistence_status_values","persistence_disclosure_rule","current_job_rule","no_duplicate_authority_rule"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "life-response-contract-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "default_mode": {"const": "PLAIN_ENGLISH_FIRST"},
    "required_sections": {
      "const": [
        "PLAIN_ENGLISH_MEANING",
        "WHAT_IS_BEING_DONE",
        "WHY_IT_MATTERS",
        "WHAT_CHANGED_OR_DID_NOT_CHANGE",
        "STATE_CLASSIFICATION",
        "PROGRESSION",
        "TECHNICAL_DETAIL",
        "PERSISTENCE_STATUS",
        "NEXT_STEP",
        "RESPONSE_COUNTER"
      ]
    },
    "state_terms": {"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "plain_english_rule": {"type":"string","minLength":1},
    "technical_only_exception": {"const":"USER_EXPLICITLY_REQUESTED_TECHNICAL_ONLY"},
    "precision_rule": {"type":"string","minLength":1},
    "platform_feature_fields": {"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "copy_paste_rule": {"type":"string","minLength":1},
    "completion_rule": {"type":"string","minLength":1},
    "progression_rule": {"type":"string","minLength":1},
    "persistence_status_values": {
      "const": ["THREAD_ONLY","DURABLE_INTAKE_RECORDED","QUEUED","IMPLEMENTING","LIVE","BLOCKED"]
    },
    "persistence_disclosure_rule": {"type":"string","minLength":1},
    "current_job_rule": {"const":"NEXT_STEP_STATES_THE_EXACT_WORK_THIS_THREAD_OWNS_AND_WILL_EXECUTE;IF_THIS_THREAD_HAS_NO_WORK_TO_CONTINUE_OUTPUT_EXACTLY_THIS_THREAD_CAN_BE_CLOSED"},
    "no_duplicate_authority_rule": {"type":"string","minLength":1}
  }
}
