{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KINETIC-DESIGN-CO/Build/blob/main/continuity/checkpoint.schema.json",
  "title": "Life Continuity Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "authority",
    "runtime_control_authority",
    "created_at",
    "source_main_sha",
    "work_id",
    "work_branch",
    "work_head_sha",
    "trigger_ids",
    "previous_checkpoint",
    "selected_work",
    "canonical_snapshot",
    "claim_observations",
    "operation_results",
    "directive_refs",
    "decision_rationale_refs",
    "research_refs",
    "live_verify",
    "resume_candidate",
    "context_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^CP-[0-9]{6}-[0-9a-f]{8}$"
    },
    "authority": {
      "const": "EVIDENCE_ONLY"
    },
    "runtime_control_authority": {
      "const": "NONE"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "work_branch": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^work/[0-9a-f-]{36}$"
    },
    "work_head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "trigger_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXPLICIT_CHECKPOINT_REQUESTED",
          "MUTATION_RESULT_TERMINAL",
          "BOOTSTRAP_CONTINUITY_EVENT_OCCURRED",
          "CANONICAL_LIVE_MISMATCH_SET_CHANGED",
          "SELECTED_WORK_OR_RANK_CHANGED",
          "OPEN_BLOCKER_SET_CHANGED",
          "LIVE_MAIN_SHA_CHANGED",
          "TRACKED_PR_STATE_CHANGED",
          "MERGE_GROUP_TERMINAL",
          "POST_MERGE_VALIDATE_TERMINAL",
          "INTERRUPTED_OPERATION_UNRESOLVED",
          "BEFORE_FINAL_REQUIRED_CLAIM_RELEASE",
          "NON_CHECKPOINT_TOOL_RESULT_COUNT_GTE_LIMIT",
          "ELAPSED_SECONDS_GTE_LIMIT_WITH_NEW_EVIDENCE"
        ]
      }
    },
    "previous_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_sha"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "blob_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "selected_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_lane",
        "selected_rank",
        "selected_work_id",
        "evaluated_at",
        "evidence_ref",
        "authority"
      ],
      "properties": {
        "worker_lane": {
          "enum": [
            "FOREGROUND",
            "PARALLEL_ASSIGNED",
            "NOT_EVALUATED"
          ]
        },
        "selected_rank": {
          "enum": [
            null,
            0,
            1,
            2,
            3,
            4
          ]
        },
        "selected_work_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "const": "HISTORICAL_OBSERVATION_ONLY"
        }
      }
    },
    "canonical_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_component",
        "current_status",
        "current_next_action_id",
        "canonical_live_mismatch_ids",
        "open_blocker_ids",
        "observed_at"
      ],
      "properties": {
        "current_component": {
          "type": "string",
          "minLength": 1
        },
        "current_status": {
          "enum": [
            "ACTIVE",
            "BLOCKED",
            "COMPLETE"
          ]
        },
        "current_next_action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_live_mismatch_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_blocker_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "goal_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_root_goal_id",
        "active_goal_id",
        "active_path",
        "observed_at",
        "authority"
      ],
      "properties": {
        "active_root_goal_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "active_goal_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "active_path": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "authority": {
          "const": "HISTORICAL_OBSERVATION_ONLY"
        }
      }
    },
    "claim_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_key",
          "lock_branch",
          "state",
          "work_id",
          "lease_id",
          "generation",
          "expires_at",
          "observed_at",
          "live_verify_required"
        ],
        "properties": {
          "resource_key": {
            "type": "string",
            "minLength": 1
          },
          "lock_branch": {
            "type": "string",
            "pattern": "^lock/[0-9a-f]{64}$"
          },
          "state": {
            "enum": [
              "ACTIVE",
              "RELEASED",
              "MISSING",
              "UNKNOWN"
            ]
          },
          "work_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "lease_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "live_verify_required": {
            "const": true
          }
        }
      }
    },
    "operation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "target",
          "operation",
          "result",
          "readback_state",
          "evidence_refs"
        ],
        "properties": {
          "system": {
            "enum": [
              "GITHUB",
              "SUPABASE",
              "VERCEL",
              "OPENAI",
              "OTHER"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "SUCCESS",
              "FAILURE",
              "NO_RESULT",
              "TIMEOUT",
              "UNKNOWN"
            ]
          },
          "readback_state": {
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "UNKNOWN",
              "NOT_RUN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "directive_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VD-[0-9]{4}$"
      }
    },
    "decision_rationale_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DR-[0-9]{4}$"
      }
    },
    "research_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_kind",
          "title",
          "url",
          "observed_date",
          "supported_claim"
        ],
        "properties": {
          "source_kind": {
            "enum": [
              "OFFICIAL",
              "ACADEMIC",
              "REDDIT",
              "REPOSITORY",
              "OTHER"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "observed_date": {
            "type": "string",
            "minLength": 1
          },
          "supported_claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "live_verify": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_class",
          "target",
          "required"
        ],
        "properties": {
          "evidence_class": {
            "enum": [
              "LIVE_GITHUB",
              "LIVE_SUPABASE",
              "LIVE_VERCEL"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "const": true
          }
        }
      }
    },
    "resume_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_state",
        "candidate_next_operation",
        "authority"
      ],
      "properties": {
        "operation_state": {
          "enum": [
            "NONE",
            "PENDING",
            "NO_RESULT",
            "TIMEOUT",
            "UNKNOWN",
            "SUCCESS",
            "FAILURE"
          ]
        },
        "candidate_next_operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "const": "NONE"
        }
      }
    },
    "context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
