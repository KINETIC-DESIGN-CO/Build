{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "life.invoke v1 input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_key",
    "request_text"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "invocation_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    }
  }
}
