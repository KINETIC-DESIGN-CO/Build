{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Semantic Firewall v1 Control Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "issuer_type", "persistence_state", "decision", "reason_codes", "decision_kind", "contract_id", "request_id", "contract_sha256", "predicate_id", "predicate_definition_sha256", "input_snapshot_sha256", "subject_type", "subject_id", "action", "scope_type", "scope_id", "operation_sha256", "evaluated_at", "expires_at", "receipt_sha256"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "issuer_type": {"type": "string", "enum": ["SOURCE_EVALUATOR", "TRUSTED_CONTROL_SERVICE"]},
    "persistence_state": {"type": "string", "enum": ["CANDIDATE", "PERSISTED_TRUSTED", "REVOKED"]},
    "decision": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "decision_kind": {"type": "string", "enum": ["AUTHORIZATION", "ROUTING", "PRIORITY", "STATE_TRANSITION", "COMPLETION", "VERIFICATION", "ESCALATION", "RELEASE", "MUTATION", "EFFECT_EXECUTION"]},
    "contract_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predicate_id": {"type": "string", "pattern": "^SF-PRED-[A-Z0-9][A-Z0-9_-]*$"},
    "predicate_definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "subject_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "scope_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "scope_id": {"type": "string", "minLength": 1},
    "operation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
