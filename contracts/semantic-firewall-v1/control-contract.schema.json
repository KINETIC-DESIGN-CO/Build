{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Semantic Firewall v1 Control Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "decision_kind", "subject_type", "subject_id", "action", "scope_type", "scope_id", "predicate_id", "required_inputs"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "contract_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "decision_kind": {"type": "string", "enum": ["AUTHORIZATION", "ROUTING", "PRIORITY", "STATE_TRANSITION", "COMPLETION", "VERIFICATION", "ESCALATION", "RELEASE", "MUTATION", "EFFECT_EXECUTION"]},
    "subject_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "subject_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "scope_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "scope_id": {"type": "string", "minLength": 1},
    "predicate_id": {"type": "string", "pattern": "^SF-PRED-[A-Z0-9][A-Z0-9_-]*$"},
    "required_inputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "value_type", "accepted_source_types", "max_age_seconds"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "value_type": {"type": "string", "enum": ["STRING", "INTEGER", "BOOLEAN", "STRING_SET", "SHA256", "OBJECT"]},
          "accepted_source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
          "max_age_seconds": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  }
}
