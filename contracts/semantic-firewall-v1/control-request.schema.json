{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Semantic Firewall v1 Control Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "decision_kind", "contract_id", "contract_sha256", "predicate_id", "predicate_definition_sha256", "subject_type", "subject_id", "action", "scope_type", "scope_id", "operation_sha256", "input_snapshot_id", "input_snapshot_sha256", "requested_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "decision_kind": {"type": "string", "enum": ["AUTHORIZATION", "ROUTING", "PRIORITY", "STATE_TRANSITION", "COMPLETION", "VERIFICATION", "ESCALATION", "RELEASE", "MUTATION", "EFFECT_EXECUTION"]},
    "contract_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predicate_id": {"type": "string", "pattern": "^SF-PRED-[A-Z0-9][A-Z0-9_-]*$"},
    "predicate_definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "subject_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "scope_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "scope_id": {"type": "string", "minLength": 1},
    "operation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "input_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}
