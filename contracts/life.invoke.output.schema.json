{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "life.invoke v1 success output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "invocation_key",
    "recorded_at",
    "request_sha256",
    "request_utf8_bytes",
    "input_provenance",
    "state",
    "replayed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "invocation_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_utf8_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "input_provenance": {
      "const": "MCP_TOOL_ARGUMENT"
    },
    "state": {
      "const": "RECORDED"
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
