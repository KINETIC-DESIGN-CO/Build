{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Source Coordination Work Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "title",
    "worker",
    "implementation_branch",
    "base_sha",
    "component_id",
    "repo_paths",
    "external_targets",
    "claims",
    "runtime_control_authority"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "work_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "chatgpt",
            "claude",
            "grok",
            "codex",
            "human",
            "other_ai"
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "implementation_branch": {
      "type": "string",
      "pattern": "^work/[0-9a-f-]{36}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "repo_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_key",
          "lock_branch",
          "lease_id",
          "generation"
        ],
        "properties": {
          "resource_key": {
            "type": "string",
            "minLength": 1
          },
          "lock_branch": {
            "type": "string",
            "pattern": "^lock/[0-9a-f]{64}$"
          },
          "lease_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "planned_goal_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "pending_external_effect_state": {
      "enum": [
        "NONE",
        "PENDING",
        "NO_RESULT",
        "TIMEOUT",
        "UNKNOWN",
        "SUCCESS",
        "FAILURE"
      ]
    },
    "runtime_control_authority": {
      "const": "NONE"
    }
  }
}
