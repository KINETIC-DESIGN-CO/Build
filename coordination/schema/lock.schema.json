{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Source Coordination Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_key",
    "generation",
    "state",
    "work_id",
    "worker",
    "implementation_branch",
    "lease_id",
    "base_sha",
    "acquired_at",
    "heartbeat_at",
    "expires_at",
    "runtime_control_authority"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "resource_key": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "state": {"enum": ["ACTIVE", "RELEASED"]},
    "work_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "session_id"],
      "properties": {
        "kind": {"enum": ["chatgpt", "claude", "grok", "codex", "human", "other_ai"]},
        "session_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
      }
    },
    "implementation_branch": {"type": "string", "pattern": "^work/[0-9a-f-]{36}$"},
    "lease_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acquired_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "lease_contract": {"enum": ["COMPONENT_1800"]},
    "lease_event_type": {"enum": ["ACQUIRE", "TAKEOVER", "REACQUIRE", "RENEW_PROTECTED_MUTATION", "RENEW_REQUIRED_CHECKPOINT"]},
    "runtime_control_authority": {"const": "NONE"}
  }
}
