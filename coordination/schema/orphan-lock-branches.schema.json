{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Orphan Lock Branch Quarantine",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "runtime_control_authority", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "life-orphan-lock-branch-quarantine-v1"},
    "runtime_control_authority": {"const": "NONE"},
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "exact_tip_sha", "disposition", "observed_at", "evidence_refs"],
        "properties": {
          "branch": {"type": "string", "pattern": "^lock/[0-9a-f]{64}$"},
          "exact_tip_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "disposition": {"const": "ABANDONED_EMPTY_CLAIM_BRANCH"},
          "observed_at": {"type": "string", "format": "date-time"},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
