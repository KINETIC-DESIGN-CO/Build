{
  "schema_version": 1,
  "protocol_id": "life-source-coordination-v1",
  "runtime_control_authority": "NONE",
  "source_coordination_authority": "GITHUB_MACHINE_STATE",
  "canonical_repository": "Vinanonymous/Build",
  "default_branch": "main",
  "work_branch_prefix": "work/",
  "lock_branch_prefix": "lock/",
  "lock_branch_derivation": "lock/ + sha256(resource_key UTF-8 lowercase hex)",
  "lease_duration_seconds": 14400,
  "renew_when_remaining_seconds_lte": 1800,
  "expiration_rule": "EXPIRED_WHEN_UTC_NOW_GTE_EXPIRES_AT",
  "resource_acquisition_order": "RESOURCE_KEY_ASCENDING_UTF8",
  "worker_kinds": [
    "chatgpt",
    "claude",
    "grok",
    "codex",
    "human",
    "other_ai"
  ],
  "required_claims": {
    "component": "component:<component_id>",
    "repository_file": "repo-file:<exact_repo_path>",
    "main_integration": "integration:main",
    "supabase_production": "external:supabase:jnenguxodtgwbskhdsxt"
  },
  "mutation_rules": [
    "WORK_BRANCH_CREATION_FROM_CURRENT_MAIN_IS_COORDINATION_BOOTSTRAP_AND_REQUIRES_NO_PRIOR_CLAIM",
    "LOCK_BRANCH_CREATE_UPDATE_AND_RELEASE_ARE_COORDINATION_CLAIM_OPERATIONS_AND_REQUIRE_NO_PRIOR_CLAIM_FOR_THAT_LOCK_BRANCH",
    "WORK_RECORD_CREATE_UPDATE_IS_COORDINATION_METADATA_AND_REQUIRES_NO_REPO_FILE_CLAIM_FOR_ITS_OWN_PATH",
    "NO_IMPLEMENTATION_REPOSITORY_CONTENT_OR_CONNECTED_APP_MUTATION_BEFORE_ALL_AFFECTED_RESOURCE_CLAIMS_ARE_ACTIVE_AND_UNEXPIRED",
    "ONE_UNIQUE_WORK_BRANCH_PER_WORK_ID",
    "LOCAL_AGENTS_USE_ONE_WORKTREE_PER_WORK_BRANCH",
    "EVERY_CHANGED_REPOSITORY_PATH_EXCEPT_THE_WORK_RECORD_REQUIRES_AN_EXACT_REPO_FILE_CLAIM",
    "EVERY_WORK_ITEM_REQUIRES_A_COMPONENT_CLAIM",
    "EVERY_PR_TO_MAIN_REQUIRES_AN_ACTIVE_INTEGRATION_MAIN_CLAIM",
    "EVERY_SUPABASE_MUTATION_REQUIRES_THE_GLOBAL_SUPABASE_PRODUCTION_CLAIM",
    "ALL_RESOURCE_CLAIMS_FOR_ONE_WORK_ITEM_ARE_ACQUIRED_IN_RESOURCE_KEY_ASCENDING_UTF8_ORDER",
    "IF_ANY_ACQUISITION_FAILS_RELEASE_ALL_CLAIMS_ACQUIRED_BY_THAT_ATTEMPT_IN_REVERSE_ORDER",
    "LEASE_RENEWAL_PRESERVES_WORK_ID_LEASE_ID_AND_GENERATION",
    "LEASE_TAKEOVER_AFTER_EXPIRY_INCREMENTS_GENERATION_BY_EXACTLY_ONE",
    "RELEASE_PRESERVES_LAST_OWNER_AND_SETS_STATE_TO_RELEASED",
    "PR_VALIDATION_MUST_VERIFY_LIVE_LOCK_BRANCH_STATE_NOT_PROSE_ISSUES_LABELS_COMMENTS_OR_REVIEWS",
    "WORK_AND_LOCK_BRANCH_MUTATIONS_DO_NOT_UPDATE_CANONICAL_LIFE_STATE_UNTIL_MAIN_INTEGRATION"
  ],
  "integration_rules": [
    "WORK_BRANCH_MUST_CONTAIN_CURRENT_MAIN_AS_ANCESTOR_WHEN_VALIDATE_RUNS",
    "REQUIRED_VALIDATE_CHECK_MUST_PASS_ON_PR_HEAD",
    "MAIN_RULESET_MUST_REQUIRE_BRANCH_TO_BE_UP_TO_DATE_BEFORE_MERGING",
    "MERGE_ONLY_WHILE_INTEGRATION_MAIN_CLAIM_IS_ACTIVE_FOR_THE_SAME_WORK_ID_AND_LEASE_ID",
    "CLOSE_ABANDONED_PR_BEFORE_RELEASING_ITS_INTEGRATION_MAIN_CLAIM"
  ],
  "coordination_surfaces": {
    "github_issues": "VISIBILITY_ONLY_ZERO_CONTROL_AUTHORITY",
    "pull_request_text": "VISIBILITY_ONLY_ZERO_CONTROL_AUTHORITY",
    "continuity_prose": "VISIBILITY_ONLY_ZERO_CONTROL_AUTHORITY"
  }
}
