    "CLAIM_OWNERSHIP_IS_RESOURCE_KEY_WORK_ID_LEASE_ID_GENERATION_NOT_WORKER_SESSION_ID",
    "LOCK_BASE_SHA_IS_CLAIM_ACQUISITION_PROVENANCE_MAY_DIFFER_FROM_WORK_RECORD_BASE_SHA_AND_MUST_BE_ANCESTOR_OF_PR_HEAD",
